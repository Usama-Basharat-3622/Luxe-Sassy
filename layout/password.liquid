<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {% render 'preload-tags' %}

    {%- case settings.style_config -%}
      {%- when 'svs' -%}
        {% render 'style-settings-svs' %}
      {%- when 'shopko' -%}
        {% render 'style-settings-shopko' %}
      {%- when 'befitting' -%}
        {% render 'style-settings-befitting' %}
      {%- else -%}
    {%- endcase -%}
    <link href="{{ 'vendor.css' | asset_url }}" rel="stylesheet" type="text/css" media="all">
    <link href="{{ 'vendor-overwrite.css' | asset_url }}" rel="stylesheet" type="text/css" media="all">
    <link href="{{ 'global.css' | asset_url }}" rel="stylesheet" type="text/css" media="all">
    <script src="{{ 'vendor.min.js' | asset_url }}" defer></script>
    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer></script>
    <script src="{{ 'shop.js' | asset_url }}" defer></script>

    {% render 'script-external-head' %}

    {{ content_for_header }}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  <body
    class="typography--body-regular scrollbar-hidden overflow-hidden"
    data-template="{{ template }}"
    data-template-name="{{ template.name }}"
    {% if template.suffix %}
      data-template-suffix="{{ template.suffix }}"
    {% endif %}
    {% if template.directory %}
      data-template-directory="{{ template.directory }}"
    {% endif %}
  >
    <a class="skip-to-content-link visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% render 'script-settings' %}

    {% render 'script-external-body' %}
  </body>
</html>
