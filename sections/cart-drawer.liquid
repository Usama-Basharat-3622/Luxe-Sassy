{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}

<cart-drawer id="CartDrawer" class="cart-drawer drawer {% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer-Overlay" class="cart-drawer-overlay"></div>
  <div
    class="cart-drawer-inner drawer__inner"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'cart.cart_drawer_title' | t }}"
    tabindex="-1"
  >
    <div class="cart-drawer-top">
      <div class="cart-drawer-header">
        <h2 class="cart-drawer-title typography--heading-2">
          <span>{{ 'cart.cart_drawer_title' | t }}</span>
        </h2>
        <button
          id="CartDrawer-Close"
          class="cart-drawer-close drawer__close icon-only-button"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>
      </div>
    </div>

    <div class="cart-drawer-center">
      {% if cart == empty %}
        <div class="cart-drawer-empty drawer__inner-empty">
          <h3 class="cart-drawer-empty-title typography--heading-2">
            {{ 'cart.empty' | t }}
          </h3>
        </div>
      {% endif %}

      <cart-drawer-items class="{% if cart == empty %} hidden{% endif %}">
        <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart-drawer-form" method="post">
          <div id="CartDrawer-CartItems" class="cart-drawer-items">
            {%- for item in cart.items -%}
              {%- assign is_gwp_item = false -%}
              {%- if item.product.type == 'GWP' -%}
                {%- assign is_gwp_item = true -%}
              {%- endif -%}

              {%- assign is_lensadvizor_item = false -%}
              {%- if item.product.tags contains 'LensAdvizor'
                or item.product.type == 'LensAdvizor'
                or item.product.vendor == 'LensAdvizor'
              -%}
                {%- assign is_lensadvizor_item = true -%}
              {%- endif -%}

              <div
                id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                class="cart-drawer-item {% if is_gwp_item %}cart-drawer-item--gwp{% endif %}"
              >
                <!-- image -->
                <div class="cart-drawer-item-media">
                  {% if item.image %}
                    <div class="ratio ratio--3-2">
                      <img
                        src="{{ item.image | image_url: width: 480 }}"
                        alt="{{ item.image.alt | escape }}"
                        loading="lazy"
                        width="{{ item.image.width }}"
                        height="{{ item.image.height }}"
                        class="media"
                      >
                    </div>

                    {% unless is_lensadvizor_item or is_gwp_item %}
                      <a class="link link--covering focus-none" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                        <span class="visually-hidden">
                          {{- 'accessibility.link_to_item' | t: item: item.product.title -}}
                        </span>
                      </a>
                    {% endunless %}
                  {% endif %}
                </div>

                <!-- details -->
                <div class="cart-drawer-item-details">
                  <!-- title -->
                  <h3 class="cart-drawer-item-title break-word typography--body-regular">
                    {% unless is_lensadvizor_item or is_gwp_item %}
                      <a href="{{ item.url }}" class="cart-drawer-item-link link link--inline-block">
                        {{- item.product.title -}}
                      </a>
                    {% else %}
                      <span class="cart-drawer-item-link link link--inline-block">
                        {{- item.product.title -}}
                      </span>
                    {% endunless %}
                  </h3>

                  <div
                    id="CartDrawer-LineItem-Error-{{ item.index | plus: 1 }}"
                    class="cart-drawer-item-error typography--body-regular-bold"
                    role="alert"
                  >
                    <p class="cart-item__error-text"></p>
                  </div>

                  <!-- option, property, plan -->
                  {%- if item.product.has_only_default_variant == false -%}
                    <div class="cart-drawer-item-option-list">
                      {%- for option in item.options_with_values -%}
                        <div class="cart-drawer-item-option typography--navigation">
                          <span class="visually-hidden">{{ option.name }}: </span>

                          <span>
                            {{- option.value -}}
                          </span>
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                  {%- if item.properties.size != 0 -%}
                    <div class="cart-drawer-item-property-list">
                      {%- for property in item.properties -%}
                        {%- assign property_first_char = property.first | slice: 0 -%}
                        {%- if property.last != blank and property_first_char != '_' -%}
                          <div class="cart-drawer-item-property typography--navigation">
                            <span>{{ property.first }}: </span>
                            <span>{{ property.last }}</span>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                  {%- if item.selling_plan_allocation != null -%}
                    <p class="cart-drawer-item-plan typography--navigation">
                      {{ item.selling_plan_allocation.selling_plan.name }}
                    </p>
                  {%- endif -%}

                  <!-- price -->
                  <div class="cart-drawer-item-price">
                    {%- comment -%}
                      when the price difference comes from real discount through shopify discount/script editor
                    {%- endcomment -%}

                    {%- if item.original_price != item.final_price -%}
                      <div class="cart-drawer-item-price cart-drawer-item-price--discounted typography--body-regular">
                        <span class="visually-hidden visually-hidden--inline">
                          {{- 'product.price.regular_price' | t -}}
                        </span>
                        <s class="cart-drawer-item-price-item cart-drawer-item-price-item--compare">
                          {%- if settings.money_trailing_zeros_enable -%}
                            {{- item.original_line_price | money -}}
                          {%- else -%}
                            {{- item.original_line_price | money_without_trailing_zeros -}}
                          {%- endif -%}
                        </s>

                        <span class="visually-hidden visually-hidden--inline">
                          {{- 'product.price.sale_price' | t -}}
                        </span>
                        <span class="cart-drawer-item-price-item cart-drawer-item-price-item--sale">
                          {%- if settings.money_trailing_zeros_enable -%}
                            {{- item.final_line_price | money -}}
                          {%- else -%}
                            {{- item.final_line_price | money_without_trailing_zeros -}}
                          {%- endif -%}
                        </span>
                      </div>

                      {%- comment -%}
                        when the price difference only comes from compare at price through product price
                      {%- endcomment -%}

                    {%- elsif item.variant.compare_at_price > item.variant.price -%}
                      <div class="cart-drawer-item-price cart-drawer-item-price-onsale typography--heading-5">
                        <span class="visually-hidden visually-hidden--inline">
                          {{- 'product.price.compare_at_price' | t -}}
                        </span>
                        <s class="cart-drawer-item-price-item cart-drawer-item-price-item--compare">
                          {%- if settings.money_trailing_zeros_enable -%}
                            {{- item.product.compare_at_price | money -}}
                          {%- else -%}
                            {{- item.product.compare_at_price | money_without_trailing_zeros -}}
                          {%- endif -%}
                        </s>

                        <span class="visually-hidden visually-hidden--inline">
                          {{- 'product.price.sale_price' | t -}}
                        </span>
                        <span class="cart-drawer-item-price-item cart-drawer-item-price-item--sale">
                          {%- if settings.money_trailing_zeros_enable -%}
                            {{- item.final_line_price | money -}}
                          {%- else -%}
                            {{- item.final_line_price | money_without_trailing_zeros -}}
                          {%- endif -%}
                        </span>
                      </div>

                      {%- comment -%}
                        when no price difference
                      {%- endcomment -%}

                    {%- else -%}
                      <div class="cart-drawer-item-price typography--body-regular">
                        <span class="visually-hidden visually-hidden--inline">
                          {{- 'product.price.regular_price' | t -}}
                        </span>
                        <span class="cart-drawer-item-price-item cart-drawer-item-price-item--regular">
                          {%- if settings.money_trailing_zeros_enable -%}
                            {{- item.final_line_price | money -}}
                          {%- else -%}
                            {{- item.final_line_price | money_without_trailing_zeros -}}
                          {%- endif -%}
                        </span>
                      </div>
                    {%- endif -%}
                  </div>
                  <!-- quantity -->
                  {%- unless is_lensadvizor_item or is_gwp_item -%}
                    <div class="cart-drawer-item-quantity-wrapper">
                      {%- assign item_count_for_variant = cart | item_count_for_variant: item.variant.id -%}
                      <span class="visually-hidden">{{ 'product.quantity.label' | t }}:</span>
                      <quantity-input class="quantity-picker cart-drawer-item-quantity-picker">
                        <button class="quantity__button" name="minus" type="button">
                          <span class="visually-hidden">
                            {{- 'product.quantity.decrease' | t: product: item.product.title | escape -}}
                          </span>
                          {{- 'icon-minus.svg' | inline_asset_content -}}
                        </button>
                        <input
                          readonly
                          id="Drawer-quantity-{{ item.index | plus: 1 }}"
                          class="quantity__input typography--body-regular"
                          type="number"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          min="1"
                          {% if item.product.metafields.custom.cl_annual_supply_boxes %}
                            {%- assign item_max = item.product.metafields.custom.cl_annual_supply_boxes
                              | divided_by: 2
                              | minus: item_count_for_variant
                              | plus: item.quantity
                            -%}
                            max="{{ item_max }}"
                          {% endif %}
                          step="1"
                          aria-label="{{ 'product.quantity.input_label' | t: product: item.product.title | escape }}"
                          data-index="{{ item.index | plus: 1 }}"
                          data-quantity-variant-id="{{ item.variant.id }}"
                          data-cart-quantity="{{ item_count_for_variant }}"
                        >
                        <button class="quantity__button" name="plus" type="button">
                          <span class="visually-hidden">
                            {{- 'product.quantity.increase' | t: product: item.product.title | escape -}}
                          </span>
                          {{- 'icon-plus.svg' | inline_asset_content -}}
                        </button>
                      </quantity-input>
                    </div>
                    <cart-remove-button data-index="{{ item.index | plus: 1 }}">
                      <button
                        type="button"
                        id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                        class="cart-drawer-item-remove icon-only-button typography--navigation"
                        aria-label="{{ 'cart.remove_title' | t: title: item.title }}"
                      >
                        <span>{{ 'cart.remove_button_label' | t }}</span>
                      </button>
                    </cart-remove-button>
                  {%- else -%}
                    <div class="cart-drawer-item-quantity-wrapper">
                      <span class="visually-hidden">{{ 'product.quantity.label' | t }}:</span>
                      <div class="cart-drawer-item-quantity--gwp typography--body-regular">
                        {{- item.quantity -}}
                      </div>
                    </div>
                  {%- endunless -%}
                </div>
              </div>
            {%- endfor -%}

            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
        </form>
      </cart-drawer-items>
    </div>

    <div class="cart-drawer-bottom cart-drawer__footer {% if cart == empty %} hidden{% endif %}">
      <div class="cart-drawer-totals" role="status">
        <h2 class="cart-drawer-totals-subtotal typography--heading-2-bold">{{ 'cart.subtotal' | t }}</h2>
        <p class="cart-drawer-totals-subtotal-value typography--heading-2-bold">
          {%- if settings.money_trailing_zeros_enable -%}
            {{- cart.total_price | money -}}
          {%- else -%}
            {{- cart.total_price | money_without_trailing_zeros -}}
          {%- endif -%}
        </p>
      </div>

      <div class="cart-drawer-ctas">
        <button
          type="submit"
          id="CartDrawer-Checkout"
          class="cart-drawer-checkout button button--primary typography--cta"
          name="checkout"
          form="CartDrawer-Form"
          {% if cart == empty %}
            disabled
          {% endif %}
        >
          {{ 'cart.checkout_button_label' | t }}
        </button>
      </div>

      <div
        id="CartDrawer-CartErrors"
        class="cart-drawer-errors typography--body-regular-bold"
        role="alert"
      ></div>
    </div>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart Drawer",
  "tag": "section",
  "class": "section--cart-drawer",
  "settings": []
}
{% endschema %}
