{% style %}

.section--clp-faq{
    border-top: 0.1rem solid rgb(var(--color-grey));
}

.clp-faq-container {
    max-width: 72.4rem;
    margin: 0 auto;
    padding: 8rem 0;
}

.clp-faq-content .icon{
    width: 2rem;
}
.clp-faq-question {
    justify-content: space-between;
    padding: 2rem 0 1.8rem 0;
    border-top: 0.1rem solid rgb(var(--color-grey));
}
.clp-faq-header{
    margin-bottom: 4rem;
}

.clp-faq-question[aria-expanded="true"] .icon-plus {
    display: none;
}
.clp-faq-question[aria-expanded="false"] .icon-minus {
    display: none;
}
.clp-faq-question[aria-expanded="true"]{
    padding-bottom: 1.6rem;
}
.clp-faq-answer{
    padding-bottom: 1.8rem;
}

@media screen and (max-width: 1100px) {

    .clp-faq-container{
        max-width: 100%;
        padding: 5.4rem 1.6rem;
    }
    .clp-faq-header{
        margin-bottom: 2.4rem;
    }
    .clp-faq-question{
        padding: 2rem 0 1.6rem 0;
    }
    .clp-faq-answer{
        padding-bottom: 1.6rem;
    }
    .clp-faq-content .icon{
        width: 1.6rem;
    }

}

{% endstyle %}



{% if questions_size > 0 %}
<div class="clp-faq-container">
    <div class="clp-faq-header">
        <h2 class="clp-faq-header-title typography--heading-1">{{ section.settings.faq_title }}</h2>
    </div>
    <div class="clp-faq-content">
        {% for i in (0..questions_size) %}
            <details-utils class="clp-faq-item">
              <details>
                <summary class="clp-faq-question typography--body-regular-bold">
                  {{ questions[i] }}
                  <span aria-hidden="true">
                    {{ 'icon-plus.svg' | inline_asset_content }}
                    {{ 'icon-minus.svg' | inline_asset_content }}
                  </span>
                </summary>
                <div class="clp-faq-answer typography--body-regular">
                  {{ answers[i] | newline_to_br }}
                </div>
              </details>
            </details-utils>
          {% endfor %}
    </div>
</div>
{% endif %}


{% schema %}
    {
      "name": "CLP FAQ",
      "tag": "section",
      "class": "section--clp-faq",
      "settings": [
        {
          "type": "text",
          "id": "faq_title",
          "label": "FAQ Title",
          "default": "Frequently Asked Questions"
        }
      ]
    }
{% endschema %}
    