<script src="{{ 'faq-accordions-handler.js' | asset_url }}" defer></script>

{% style %}

.accordions-{{ section.id }}{
    width: 100%;
    max-width: 72.4rem;
    margin: auto;
}
.accordions-{{ section.id }} .accordion-wrapper .accordion-title.active:last-of-type{
    border-bottom: 0px;
}

/* accordion-title */
.accordions-{{ section.id }} .accordion-title {
    cursor: pointer;
    padding: 2rem 0rem 1.6rem;
    width: 100%;
    text-align: left;
    border-top: 1px solid rgb(var(--color-grey)) !important;
    position: relative;
    transition: none;
}
.accordions-{{ section.id }} .accordion-title:focus {
    outline: .2rem solid rgb(var(--color-focus));
    outline-offset: .3rem;
    z-index: 10;
}
.accordions-{{ section.id }} .accordion-title:after {
    content: '';
    background-image: url("data:image/svg+xml,%3Csvg width='16' height='15' viewBox='0 0 16 15' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cline x1='0.5' y1='7.5' x2='15.5' y2='7.5' stroke='%23201F1E'/%3E%3Cline x1='8' x2='8' y2='15' stroke='%23201F1E'/%3E%3C/svg%3E");
    float: right;
    margin-left: 0.5rem;
    width: 15px;
    height: 15px;
    background-size: auto;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}
.accordions-{{ section.id }} .accordion-title.active:after {
    content: "";
    width: 15px;
    height: 1px;
    background-image: url("data:image/svg+xml,%3Csvg width='16' height='2' viewBox='0 0 16 2' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cline x1='0.5' y1='1' x2='15.5' y2='1' stroke='%23201F1E'/%3E%3C/svg%3E");
    background-size: auto;
}
/* accordion-detail */

.accordions-{{ section.id }} .accordion-title{
    cursor: pointer;
    outline: none;
    transition: 0.4s;
    border: none;
    padding-right: 2.5rem;
}
.accordions-{{ section.id }} .accordion-detail {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.2s ease-out;
    padding-right: 2rem;
}

.accordions-{{ section.id }} .accordion-item {
    display: none;
}
.accordions-{{ section.id }} .accordion-item.active {
    display: block;
}

.accordions-{{ section.id }} .filter-button.active{
    border: .1rem solid rgb(var(--color-black));
}
.accordions-{{ section.id }} .accordion-navigation {
    display: flex;
    overflow: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
    max-width: unset;
    margin-left: unset;
    flex-flow: row nowrap;
    max-width: 100%;
    width: fit-content;
    margin-inline: auto;
    gap: 1.6rem;
}
.accordions-{{ section.id }} .filter-button{
    text-decoration: none;
}
#accordions-{{ section.id }} .accordion-detail > * {
    margin-bottom: 1.8rem;
}

#accordions-{{ section.id }}{  
    {% if section.settings.show_border_top %}
        border-top: .1rem solid rgb(var(--color-grey));
    {% endif %}
    {% if section.settings.show_border_bottom %}
        border-bottom: .1rem solid rgb(var(--color-grey));
    {% endif %}
}

@media screen and (min-width: 768px){
    #accordions-{{ section.id }}{
        padding: {{ section.settings.padding_top }}px 2.4rem {{ section.settings.padding_bottom }}px;
    }
    .accordions-{{ section.id }} .accordion-navigation {
        padding: 2rem 0rem 4.8rem;
    }
    .accordions-{{ section.id }} .accordion-wrapper {
        margin-bottom: 4rem;
    }
}
@media screen and (max-width: 767px) {
    #accordions-{{ section.id }}{
        padding: {{ section.settings.padding_top_mob }}px 0 {{ section.settings.padding_bottom_mob }}px;
    }
    .accordions-{{ section.id }} .accordion-navigation {
        padding: 2rem 0rem 3.2rem 1.6rem;
    }
    .accordions-{{ section.id }} .accordion-wrapper {
        margin-bottom: 2rem;
    }
    #accordions-{{ section.id }} .accordion-item-wrapper{
        padding: 0rem 1.6rem;
    }
    .accordions-{{ section.id }} .accordion-title:after {
        width: 11px;
        height: 11px;
        top: 52%;
    }
    .accordions-{{ section.id }} .accordion-title.active:after {
        width: 11px;
    }
    .accordions-{{ section.id }} .accordion-navigation {
        gap: 1.2rem;
    }
    .accordions-{{ section.id }} .accordion-navigation > :last-child {
        margin-right: 1.6rem;
    }
    .accordions-{{ section.id }} .accordion-title, .accordions-{{ section.id }} .accordion-detail{
        padding-right: 1.7rem;
    }
}
{% endstyle %}

