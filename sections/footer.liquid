{{ 'footer.css' | asset_url | stylesheet_tag }}

{% style %}

.footer{
  background-color: {{ section.settings.footer_background_color }};
}

.footer-payments svg{
  fill: {{ section.settings.footer_background_color }};
}

{% endstyle %}

<footer class="footer">

  <div class="footer-inner">
    <div class="footer-links" role="navigation" aria-label="Footer navigation">
      {%- for block in section.blocks -%}
        {%- if block.settings.menu != blank -%}
          <details-utils class="footer-block__details-content" force-open="(min-width: 1181px)">
            <details>
              {%- if block.settings.heading != blank -%}
                <summary class="footer-block__details-content-title typography--body-regular-bold" tabindex="-1">
                  {{ block.settings.heading | escape }}
                  <span aria-hidden="true">
                    {{- 'icon-plus.svg' | inline_asset_content -}}
                    {{- 'icon-minus.svg' | inline_asset_content -}}
                  </span>
                </summary>
              {%- endif -%}
              <ul class="list-unstyled">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a
                      href="{{ link.url }}"
                      class="link link--inline-block  link--hover-color-change  typography--body-regular"
                    >
                      {{ link.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          </details-utils>
        {%- endif -%}
        {%- if block.type == 'newsletter' -%}
          <details-utils class="footer-block__details-content footer-newsletter-container" aria-labelledby="newsletter-title" force-open="(min-width: 1181px)">
            <details>
              {%- if block.settings.heading != blank -%}
                <summary class="footer-block__details-content-title typography--body-regular-bold" tabindex="-1">
                  {{ block.settings.heading | escape }}
                  <span aria-hidden="true">
                    {{- 'icon-plus.svg' | inline_asset_content -}}
                    {{- 'icon-minus.svg' | inline_asset_content -}}
                  </span>
                </summary>
              {%- endif -%}
              <ul class="footer-block__newsletter">
                {%- if section.settings.newsletter_heading != blank -%}
                  <h2 class="footer-block__heading inline-richtext">{{ section.settings.newsletter_heading }}</h2>
                {%- endif -%}
                {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="newsletter-form__field-wrapper">
                    <div class="field field--input">
                      <label class="newsletter-label typography--body-regular" for="NewsletterForm--{{ section.id }}">
                        {{ block.settings.newsletter_title }}
                      </label>
                      <input
                        id="NewsletterForm--{{ section.id }}"
                        type="email"
                        name="contact[email]"
                        class="typography--body-regular"
                        value="{{ form.email }}"
                        aria-required="true"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
                        {% if form.errors %}
                          autofocus
                          aria-invalid="true"
                          aria-describedby="ContactFooter-error"
                        {% elsif form.posted_successfully? %}
                          aria-describedby="ContactFooter-success"
                        {% endif %}
                        placeholder="{{ block.settings.newsletter_placeholder }}"
                        required
                      >
                      </div>
                      
                      <button
                        type="submit"
                        class="newsletter-form__button button button--primary typography--body-regular"
                        name="commit"
                        id="Subscribe"
                        aria-label="{{ block.settings.newsletter_button }}"
                        {% if form.posted_successfully? %} disabled {% endif %}
                      >
                      {{ block.settings.newsletter_button }}
                      </button>
                  </div>
                  {%- if form.posted_successfully? -%}
                    {% style %}
                    .newsletter-form__button {
                      cursor: not-allowed !important;
                      opacity: 0.6;
                    }
                    {% endstyle %}
                    <div
                      class="footer-newsletter-success-message typography--body-regular"
                      id="ContactFooter-success"
                      tabindex="-1"
                      autofocus
                    >
                    <span class="svg-wrapper">
                      {{- 'icon-successs.svg' | inline_asset_content -}}
                    </span>
                      {{ block.settings.success_message }}
                    </div>
                  {%- endif -%}
                {%- endform -%}
              </ul>
            </details>
          </details-utils>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="footer-bottom typography--body-small">
    <div class="footer-copyright">
      <div class="footer-copyright-name ">{{ shop.name }}@2025</div>
      <div class="footer-copyright-rights ">{{ 'copyright.copyright' | t }}</div>
    </div>

    <div class="footer-payments">
      {% if section.settings.visa %}
        {{- 'icon-social-Visa.svg' | inline_asset_content -}}
      {% endif %}
      {% if section.settings.mastercard %}
        {{- 'icon-social-Mastercard.svg' | inline_asset_content -}}
      {% endif %}
      {% if section.settings.paypal %}
        {{- 'icon-social-PayPal.svg' | inline_asset_content -}}
      {% endif %}
      {% if section.settings.applepay %}
        {{- 'icon-social-ApplePay.svg' | inline_asset_content -}}
      {% endif %}
      {% if section.settings.klarna %}
        {{- 'icon-social-Klarna.svg' | inline_asset_content -}}
      {% endif %}
      {% if section.settings.afterpay %}
        {{- 'icon-social-afterpay.svg' | inline_asset_content -}}
      {% endif %}
      {% if section.settings.gpay %}
        {{- 'icon-social-gpay.svg' | inline_asset_content -}}
      {% endif %}
    </div>

    <div class="footer-mobile-copyrights">
      <div class="footer-copyright-name-mobile ">{{ shop.name }}@2025,</div>
      <div class="footer-copyright-rights-mobile ">
        {{ 'copyright.copyright' | t }}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section--footer",
  "limit": 1,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Footer Background Color"
    },
    {
      "type": "color",
      "id": "footer_background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Payment Methods (displays icons on footer)"
    },
    {
      "type": "checkbox",
      "id": "visa",
      "label": "Visa",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mastercard",
      "label": "Mastercard",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "paypal",
      "label": "Paypal",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "applepay",
      "label": "Apple Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "klarna",
      "label": "Klarna",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "afterpay",
      "label": "Afterpay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "gpay",
      "label": "Google Pay",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Newsletter",
          "label": "Heading"
        },
        {
          "type": "header",
          "content": "Newsletter"
        },
        {
          "type": "text",
          "id": "newsletter_title",
          "label": "Newsletter Title",
          "default": "Sign up to our newsletter to receive exclusive offers."
        },
        {
          "type": "text",
          "id": "newsletter_placeholder",
          "label": "Newsletter Placeholder",
          "default": "Enter your email"
        },
        {
          "type": "text",
          "id": "newsletter_button",
          "label": "Newsletter Button",
          "default": "Subscribe"
        },
        {
          "type": "richtext",
          "id": "success_message",
          "label": "Success Message",
          "default": "<p>Thankyou for Subscribing</p>"
        }
      ]
    }
  ]
}
{% endschema %}
