{{ 'section-content-blocks.css' | asset_url | stylesheet_tag }}

{% style %}
  .content-blocks-carousel-{{ section.id }}{
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      {% if section.settings.show_border_top %}
          border-top: .1rem solid rgb(var(--color-grey));
      {% endif %}
      {% if section.settings.show_border_bottom %}
          border-bottom: .1rem solid rgb(var(--color-grey));
      {% endif %}
      display: block;
  }

  {%- comment -%} Section title / paragraph colors {%- endcomment -%}
  {% if section.settings.title_color != blank %}
    .content-blocks-carousel-{{ section.id }} .content-blocks-carousel-title{
        color: {{ section.settings.title_color }};
    }
  {% endif %}
  {% if section.settings.paragraph_color != blank %}
    .content-blocks-carousel-{{ section.id }} .content-blocks-carousel-paragraph{
        color: {{ section.settings.paragraph_color }};
    }
  {% endif %}

  @media screen and (min-width: 1025px) {
      .content-blocks-carousel-{{ section.id }}{
          padding: {{ section.settings.padding_top }}px 2.4rem {{ section.settings.padding_bottom }}px;
      }
      .content-blocks-carousel-{{ section.id }} .content-blocks-carousel-title{
          font-size: {{ section.settings.title_size_desktop }}px;
      }
      .content-blocks-carousel-{{ section.id }} .content-blocks-carousel-paragraph{
          font-size: {{ section.settings.paragraph_size_desktop }}px;
      }
  }

  @media only screen and (max-width: 1024px) {
      .content-blocks-carousel-{{ section.id }}{
          padding: {{ section.settings.padding_top_alter }}px 0rem {{ section.settings.padding_bottom_alter }}px;
      }
      .cb-slider-scrollbar.swiper-scrollbar{
          background: rgb(var(--color-grey-medium));
          height: 0.1rem;
          transition: height 0.3s ease;
          cursor: pointer;
      }
      .content-blocks-carousel-{{ section.id }} .content-blocks-carousel-title{
          font-size: {{ section.settings.title_size_mobile }}px;
      }
      .content-blocks-carousel-{{ section.id }} .content-blocks-carousel-paragraph{
          font-size: {{ section.settings.paragraph_size_mobile }}px;
      }
  }

  {% for block in section.blocks %}
      {%- comment -%} Block title / paragraph colors {%- endcomment -%}
      {% if block.settings.title_color != blank %}
        .content-block-item-{{ block.id }} .content-block-title{
            color: {{ block.settings.title_color }};
        }
      {% endif %}
      {% if block.settings.paragraph_color != blank %}
        .content-block-item-{{ block.id }} .content-block-excerpt{
            color: {{ block.settings.paragraph_color }};
        }
      {% endif %}

      @media screen and (min-width: 768px){
          .content-block-item-{{ block.id }} .content-block-info{
              text-align: {{ block.settings.text_alignment }};
              align-items: {{ block.settings.text_alignment }};
          }
          .content-block-item-{{ block.id }} .content-block-title{
              font-size: {{ block.settings.title_size_desktop }}px;
          }
          .content-block-item-{{ block.id }} .content-block-excerpt{
              font-size: {{ block.settings.paragraph_size_desktop }}px;
          }
      }
      @media screen and (max-width: 767px){
          .content-block-item-{{ block.id }} .content-block-info{
              text-align: {{ block.settings.text_alignment_alter }};
              align-items: {{ block.settings.text_alignment_alter }};
          }
          .content-block-item-{{ block.id }} .content-block-title{
              font-size: {{ block.settings.title_size_mobile }}px;
          }
          .content-block-item-{{ block.id }} .content-block-excerpt{
              font-size: {{ block.settings.paragraph_size_mobile }}px;
          }
      }
  {% endfor %}
{% endstyle %}

<content-blocks
  id="content-blocks-carousel-{{ section.id }}"
  class="content-blocks-carousel-{{ section.id }} content-blocks-carousel isolate"
  role="region"
  data-block-count="{{ section.blocks.size }}"
  data-slides-mobile="{{ section.settings.slides_per_view_mobile }}"
>
  {%- if section.settings.title != blank or section.settings.paragraph != blank -%}
    <div class="header-content">
      {%- if section.settings.title != blank -%}
        <h2 class="content-blocks-carousel-title typography--heading-1">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.paragraph != blank -%}
        <div class="content-blocks-carousel-paragraph typography--body-regular">
          {{ section.settings.paragraph }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="swiper isolate">
    <div class="swiper-wrapper content-block-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide content-block-item content-block-item-{{ block.id }}">
          <div class="content-block">
            <div class="content-block-top">
              {% if block.settings.image != blank %}
                <img
                  srcset="{% render 'image-srcset', image: block.settings.image %}"
                  sizes="(min-width: 992px) calc( 100vw / {{ section.blocks.size }} ), 50vw"
                  src="{{ block.settings.image | image_url: width: 2048 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                  class="media hidden≤767"
                  style="--focal-point-x: {{ block.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ block.settings.image.presentation.focal_point.y }}%"
                >
              {% endif %}
              {%- if block.settings.image_alter -%}
                <img
                  srcset="{% render 'image-srcset', image: block.settings.image_alter %}"
                  sizes="(min-width: 992px) calc( 100vw / {{ section.blocks.size }} ), 50vw"
                  src="{{ block.settings.image_alter | image_url: width: 2048 }}"
                  alt="{{ block.settings.image_alter.alt | escape }}"
                  width="{{ block.settings.image_alter.width }}"
                  height="{{ block.settings.image_alter.height }}"
                  loading="lazy"
                  class="media hidden≥768"
                  style="--focal-point-x: {{ block.settings.image_alter.presentation.focal_point.x }}%; --focal-point-y: {{ block.settings.image_alter.presentation.focal_point.y }}%"
                >

              {%- elsif block.settings.image != blank -%}
                <img
                  srcset="{% render 'image-srcset', image: block.settings.image %}"
                  sizes="(min-width: 992px) calc( 100vw / {{ section.blocks.size }} ), 50vw"
                  src="{{ block.settings.image | image_url: width: 2048 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                  class="media hidden≥768"
                  style="--focal-point-x: {{ block.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ block.settings.image.presentation.focal_point.y }}%"
                >
              {%- endif -%}
            </div>

            <div class="content-block-info">
              {%- if block.settings.title != blank -%}
                <div class="content-block-title typography--heading-2">
                  {{ block.settings.title }}
                </div>
              {%- endif -%}

              {%- if block.settings.paragraph != blank -%}
                <div class="content-wrapper typography--body-small">
                  <div class="content-block-excerpt">
                    {{ block.settings.paragraph }}
                  </div>
                  {%- if block.settings.cta_link == blank and block.settings.cta_text == blank -%}
                    <button
                      class="view-more-button link link--hover-color-change typography--navigation"
                      style="display: none;"
                    >
                      View more
                    </button>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if block.settings.cta_link != blank and block.settings.cta_text != blank -%}
                <a
                  href="{{ block.settings.cta_link }}"
                  class="content-block-link link link--underline link--hover-color-change typography--navigation"
                  aria-label="{{ block.settings.cta_text }}"
                  {%- if block.settings.cta_link contains 'http' -%}
                    target="_blank"
                  {%- endif -%}
                >
                  {{ block.settings.cta_text }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="cb-slider-scrollbar swiper-scrollbar"></div>
  </div>
</content-blocks>

{% schema %}
{
  "name": "Content Blocks",
  "tag": "section",
  "max_blocks": 4,
  "class": "section--article-related-grid",
  "enabled_on": {
    "templates": [
      "page",
      "index"
    ]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#201F1E"
    },
    {
      "type": "checkbox",
      "id": "show_border_top",
      "label": "Show Border Top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "Show Border Bottom",
      "default": false
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Content Blocks"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph"
    },
    {
      "type": "header",
      "content": "Title Style"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 12,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Title size desktop",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 12,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Title size mobile",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color"
    },
    {
      "type": "header",
      "content": "Paragraph Style"
    },
    {
      "type": "range",
      "id": "paragraph_size_desktop",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Paragraph size desktop",
      "default": 16
    },
    {
      "type": "range",
      "id": "paragraph_size_mobile",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Paragraph size mobile",
      "default": 16
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Paragraph color"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Carousel (Mobile)"
    },
    {
      "type": "select",
      "id": "slides_per_view_mobile",
      "label": "Slides per view (Mobile)",
      "info": "Decimal values show a peek of the next slide, which signals that the carousel scrolls.",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "1.2", "label": "1.2 (peek)" },
        { "value": "1.5", "label": "1.5 (peek)" },
        { "value": "2", "label": "2" },
        { "value": "2.18", "label": "2.18 (peek, current default)" },
        { "value": "2.5", "label": "2.5 (peek)" },
        { "value": "3", "label": "3" }
      ],
      "default": "2.18"
    }
  ],
  "blocks": [
    {
      "name": "Tab",
      "type": "content-blocks",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_alter",
          "label": "Image (Mobile)"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Necklaces"
        },
        {
          "type": "richtext",
          "id": "paragraph",
          "label": "Paragraph"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Text"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA Link"
        },
        {
          "type": "header",
          "content": "Title Style"
        },
        {
          "type": "range",
          "id": "title_size_desktop",
          "min": 10,
          "max": 80,
          "step": 1,
          "unit": "px",
          "label": "Title size desktop",
          "default": 16
        },
        {
          "type": "range",
          "id": "title_size_mobile",
          "min": 10,
          "max": 80,
          "step": 1,
          "unit": "px",
          "label": "Title size mobile",
          "default": 16
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color"
        },
        {
          "type": "header",
          "content": "Paragraph Style"
        },
        {
          "type": "range",
          "id": "paragraph_size_desktop",
          "min": 10,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Paragraph size desktop",
          "default": 13
        },
        {
          "type": "range",
          "id": "paragraph_size_mobile",
          "min": 10,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Paragraph size mobile",
          "default": 13
        },
        {
          "type": "color",
          "id": "paragraph_color",
          "label": "Paragraph color"
        },
        {
          "type": "header",
          "content": "Alignment"
        },
        {
          "type": "radio",
          "id": "text_alignment",
          "label": "Text Alignment",
          "options": [
            {
              "value": "start",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "end",
              "label": "Right"
            }
          ],
          "default": "start"
        },
        {
          "type": "radio",
          "id": "text_alignment_alter",
          "label": "Text Alignment Mobile",
          "options": [
            {
              "value": "start",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "end",
              "label": "Right"
            }
          ],
          "default": "start"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Content Blocks"
    }
  ]
}
{% endschema %}
