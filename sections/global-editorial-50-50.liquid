{{ 'section-editorial-50-50.css' | asset_url | stylesheet_tag }}

<div
  id="editorial-50-50-{{ section.id }}"
  class="editorial-50-50-{{ section.id }} editorial-50-50 isolate"
>
  <div class="banner banner">
    <div class="banner-media">
      {%- case section.settings.media_type -%}
        {%- when 'image' -%}
          {% if section.settings.image != blank %}
            <img
              srcset="{% render 'image-srcset', image: section.settings.image %}"
              sizes="50vw"
              src="{{ section.settings.image | image_url: width: 2048 }}"
              alt="{{ section.settings.image.alt | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
              class="media hidden≤767"
              style="--focal-point-x: {{ section.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image.presentation.focal_point.y }}%"
            >
          {% endif %}
          {%- if section.settings.image_alter -%}
            <img
              srcset="{% render 'image-srcset', image: section.settings.image_alter %}"
              sizes="100vw"
              src="{{ section.settings.image_alter | image_url: width: 2048 }}"
              alt="{{ section.settings.image_alter.alt | escape }}"
              width="{{ section.settings.image_alter.width }}"
              height="{{ section.settings.image_alter.height }}"
              loading="lazy"
              class="media hidden≥768"
              style="--focal-point-x: {{ section.settings.image_alter.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image_alter.presentation.focal_point.y }}%"
            >

          {%- elsif section.settings.image != blank -%}
            <img
              srcset="{% render 'image-srcset', image: section.settings.image %}"
              sizes="100vw"
              src="{{ section.settings.image | image_url: width: 2048 }}"
              alt="{{ section.settings.image.alt | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
              class="media hidden≥768"
              style="--focal-point-x: {{ section.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image.presentation.focal_point.y }}%"
            >
          {%- endif -%}

        {%- when 'video' -%}
          {% if section.settings.video != blank %}
            <video
              alt="{{ section.settings.video.alt | escape }}"
              width="{{ section.settings.video.preview_image.width }}"
              height="{{ section.settings.video.preview_image.height }}"
              autoplay
              playsinline
              muted
              loop
              preload="false"
              loading="lazy"
              class="media hidden≤767"
            >
              {% for source in section.settings.video.sources %}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {% endfor %}
            </video>
          {% endif %}

          {%- if section.settings.video_alter -%}
            <video
              alt="{{ section.settings.video_alter.alt | escape }}"
              width="{{ section.settings.video_alter.preview_image.width }}"
              height="{{ section.settings.video_alter.preview_image.height }}"
              autoplay
              playsinline
              muted
              loop
              preload="false"
              loading="lazy"
              class="media hidden≥768"
            >
              {% for source in section.settings.video_alter.sources %}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {% endfor %}
            </video>

          {%- elsif section.settings.video != blank -%}
            <video
              alt="{{ section.settings.video.alt | escape }}"
              width="{{ section.settings.video.preview_image.width }}"
              height="{{ section.settings.video.preview_image.height }}"
              autoplay
              playsinline
              muted
              loop
              preload="false"
              loading="lazy"
              class="media hidden≥768"
            >
              {% for source in section.settings.video.sources %}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {% endfor %}
            </video>
          {%- endif -%}
      {%- endcase -%}
    </div>

    <div class="banner-content">
      {%- if section.settings.title != blank -%}
        <h2 class="banner-title typography--heading-1">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.paragraph != blank -%}
        <div class="banner-paragraph {% if section.settings.paragraph_size == 'regular' %} typography--body-regular {% elsif section.settings.paragraph_size == 'small' %} typography--body-small {% endif %}">
          {{
            section.settings.paragraph
            | replace: '<h1', "<h1 class='h1 typography--heading-1'"
            | replace: '<h2', "<h2 class='h2 typography--heading-2'"
            | replace: '<strong', "<strong class='typography--body-regular-bold'"
            | replace: '<a', "<a class='link link--inline-block link--hover-color-change'"
          }}
        </div>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a
          href="{{ section.settings.cta_link }}"
          class="banner-cta link button button--tertiary typography--body-regular"
          aria-label="{{ section.settings.cta_text }}"
          {%- if section.settings.cta_link contains 'http' -%}
            target="_blank"
          {%- endif -%}
        >
          {{- section.settings.cta_text -}}
          {{ 'icon-arrow-full_upright.svg' | inline_asset_content }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .editorial-50-50-{{ section.id }}{
    {% if section.settings.show_border_top %}
        border-top: .1rem solid rgb(var(--color-grey));
    {% endif %}
    {% if section.settings.show_border_bottom %}
        border-bottom: .1rem solid rgb(var(--color-grey));
    {% endif %}
  }

  .editorial-50-50-{{ section.id }} .banner-content{
    background-color: {{ section.settings.background_color }};
  }

  .editorial-50-50-{{ section.id }} .banner-content > * {
    max-width: {{ section.settings.text_max_width }}px;
  }

  .editorial-50-50-{{ section.id }} .banner-title,
  .editorial-50-50-{{ section.id }} .banner-paragraph{
    color: {{ section.settings.text_color }}
  }

  @media screen and (min-width: 992px) {
    .editorial-50-50-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .editorial-50-50-{{ section.id }} .banner{
      flex-direction: {{ section.settings.flex_direction }};
    }
    .editorial-50-50-{{ section.id }} .banner-content{
      display: grid;
      justify-content: {{ section.settings.text_placement_hor }};
      align-content: {{ section.settings.text_placement_vert }};
      justify-items: {{ section.settings.text_alignment }};
      text-align: {{ section.settings.text_alignment }};
    }
  }

  @media only screen and (max-width: 991px) {
    .editorial-50-50-{{ section.id }}{
      padding-top: {{ section.settings.padding_top_alter }}px;
      padding-bottom: {{ section.settings.padding_bottom_alter }}px;
    }
    .editorial-50-50-{{ section.id }} .banner{
      flex-direction: {{ section.settings.flex_direction_alter }};
    }
    .editorial-50-50-{{ section.id }} .banner-content{
      display: grid;
      justify-content: {{ section.settings.text_placement_hor_alter }};
      justify-items: {{ section.settings.text_alignment_alter }};
      text-align: {{ section.settings.text_alignment_alter }};
    }
    .editorial-50-50-{{ section.id }} .banner-content > * {
      max-width: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Editorial 50-50",
  "tag": "section",
  "class": "section--editorial-50-50",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_border_top",
      "label": "Show Border Top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "Show Border Bottom",
      "default": false
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "radio",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },

    {
      "type": "image_picker",
      "id": "image_alter",
      "label": "Image (Mobile)"
    },

    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },

    {
      "type": "video",
      "id": "video_alter",
      "label": "Video (Mobile)"
    },
    {
      "type": "header",
      "content": "Media Position"
    },
    {
      "type": "radio",
      "id": "flex_direction",
      "label": "Media Position",
      "options": [
        {
          "value": "row",
          "label": "Left"
        },
        {
          "value": "row-reverse",
          "label": "Right"
        }
      ],
      "default": "row"
    },
    {
      "type": "radio",
      "id": "flex_direction_alter",
      "label": "Media Position (Mobile)",
      "options": [
        {
          "value": "column",
          "label": "Top"
        },
        {
          "value": "column-reverse",
          "label": "Bottom"
        }
      ],
      "default": "column"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph"
    },
    {
      "type": "select",
      "id": "paragraph_size",
      "label": "Paragraph Size",
      "options": [
        {
          "value": "regular",
          "label": "Regular"
        },
        {
          "value": "small",
          "label": "Small"
        }
      ],
      "default": "regular"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "range",
      "id": "text_max_width",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Text Max Width",
      "default": 400
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#201F1E"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F8F8F8"
    },
    {
      "type": "radio",
      "id": "text_placement_hor",
      "label": "Text Placement Horizontal",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_placement_vert",
      "label": "Text Placement Vertical",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_placement_hor_alter",
      "label": "Text Placement Horizontal (Mobile)",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_alignment_alter",
      "label": "Text Alignment (Mobile)",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Editorial 50-50"
    }
  ]
}
{% endschema %}
