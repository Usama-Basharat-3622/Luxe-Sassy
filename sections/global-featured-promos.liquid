<div class="featured-promos-section featured-promos-section-{{ section.id }}">
  <div class="promo-grid">
    {% for block in section.blocks %}
      <div class="promo-item">
        {% if block.settings.image %}
          <img
            class="promo-image-desktop"
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% endif %}

        {% if block.settings.image_mobile %}
          <img
            class="promo-image-mobile"
            src="{{ block.settings.image_mobile | image_url: width: 800 }}"
            alt="{{ block.settings.image_mobile.alt | escape }}"
            width="{{ block.settings.image_mobile.width }}"
            height="{{ block.settings.image_mobile.height }}"
          >
        {% endif %}

        <div class="promo-text">
          {% if block.settings.heading %}
            <div class="promo-heading">
              {{ block.settings.heading }}
            </div>
          {% endif %}
          {% if block.settings.description %}
            <div class="promo-description">
              {{ block.settings.description }}
            </div>
          {% endif %}
          {% if block.settings.link_text and block.settings.link_url %}
            <a href="{{ block.settings.link_url }}" class="promo-link">
              {{ block.settings.link_text }}
            </a>
          {% endif %}
          {% if block.settings.disclaimer %}
            <div class="promo-disclaimer">
              {{ block.settings.disclaimer }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% style %}
  .featured-promos-section-{{ section.id }} {
    {% if section.settings.bg_color %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
    {% if section.settings.text_color %}
      color: {{ section.settings.text_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    max-width: {{ section.settings.container_width }}px;
    margin-left: {% case section.settings.container_alignment %}
      {% when 'left' %} 0;
      {% when 'center' %} auto;
      {% when 'right' %} auto;
    {% endcase %}
    margin-right: {% case section.settings.container_alignment %}
      {% when 'left' %} auto;
      {% when 'center' %} auto;
      {% when 'right' %} 0;
    {% endcase %}
  }
{% endstyle %}

<style>
  .promo-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
  }

  .promo-item {
    display: flex;
    flex: 1 1 calc(50% - 1.5rem);
    gap: 2rem;
    align-items: flex-start;
    box-sizing: border-box;
    max-width: calc(50% - 1.5rem);
  }

  .promo-image img {
    max-width: 255px;
    width: 100%;
    height: auto;
    display: block;
  }

  .promo-image-desktop {
    max-width: 255px;
    width: 100%;
    height: auto;
    display: block;
  }

  .promo-image-mobile {
    display: none;
    max-width: 255px;
    width: 100%;
    height: auto;
  }

  .promo-text {
    flex: 1;
  }

  .promo-heading {
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .promo-description,
  .promo-disclaimer {
    margin-bottom: 0.5rem;
  }

  .promo-disclaimer p {
    font-size: 0.68em;
    line-height: 1.35em;
    padding-top: 0.5rem;
  }

  @media only screen and (max-width: 767px) {
    .featured-promos-section {
      padding-left: 1.6rem;
      padding-right: 1.6rem;
    }

    .promo-item {
      flex-direction: column;
      max-width: 100%;
      max-width: 100%;
      flex: none;
    }

    .promo-image {
      margin-bottom: 1rem;
    }

    .promo-image-desktop {
      display: none;
    }

    .promo-image-mobile {
      display: block;
      max-width: none;
    }

    .promo-disclaimer p {
      font-size: 0.78em;
    }
  }
</style>

{% schema %}
{
  "name": "Global Featured Promos",
  "tag": "section",
  "class": "section--featured-promos",
  "max_blocks": 2,
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "number",
      "id": "container_width",
      "label": "Container Width (px)",
      "default": 1200,
      "info": "Enter a pixel value like 724"
    },
    {
      "type": "select",
      "id": "container_alignment",
      "label": "Container Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Promo Image (Desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Promo Image (Mobile)"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "richtext",
          "id": "disclaimer",
          "label": "Disclaimer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Global Featured Promos"
    }
  ]
}
{% endschema %}
