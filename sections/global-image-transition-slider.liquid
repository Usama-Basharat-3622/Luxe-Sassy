{{ 'section-image-transition-slider.css' | asset_url | stylesheet_tag }}

<div
  id="image-transition-slider-50-50-{{ section.id }}"
  class="image-transition-slider-50-50-{{ section.id }} image-transition-slider-50-50 isolate"
>
  <div class="banner banner">
    <div class="banner-media">

        <div class="image-range-wrapper">
            <div class="image-container image-container-1">
                {% if section.settings.image != blank %}
                    <img
                    srcset="{% render 'image-srcset', image: section.settings.image %}"
                    sizes="50vw"
                    src="{{ section.settings.image | image_url: width: 2048 }}"
                    alt="{{ section.settings.image.alt | escape }}"
                    width="{{ section.settings.image.width }}"
                    height="{{ section.settings.image.height }}"
                    loading="lazy"
                    class="media hidden≤767 image-base"
                    style="--focal-point-x: {{ section.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image.presentation.focal_point.y }}%"
                    >
                {% endif %}
                {%- if section.settings.image_alter -%}
                    <img
                    srcset="{% render 'image-srcset', image: section.settings.image_alter %}"
                    sizes="100vw"
                    src="{{ section.settings.image_alter | image_url: width: 2048 }}"
                    alt="{{ section.settings.image_alter.alt | escape }}"
                    width="{{ section.settings.image_alter.width }}"
                    height="{{ section.settings.image_alter.height }}"
                    loading="lazy"
                    class="media hidden≥768 image-base"
                    style="--focal-point-x: {{ section.settings.image_alter.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image_alter.presentation.focal_point.y }}%"
                    >
        
                {%- elsif section.settings.image != blank -%}
                    <img
                    srcset="{% render 'image-srcset', image: section.settings.image %}"
                    sizes="100vw"
                    src="{{ section.settings.image | image_url: width: 2048 }}"
                    alt="{{ section.settings.image.alt | escape }}"
                    width="{{ section.settings.image.width }}"
                    height="{{ section.settings.image.height }}"
                    loading="lazy"
                    class="media hidden≥768 image-base"
                    style="--focal-point-x: {{ section.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image.presentation.focal_point.y }}%"
                    >
                {%- endif -%}
            </div>
            <div class="image-container image-container-2">
                {% if section.settings.image2 != blank %}
                    <img
                    srcset="{% render 'image-srcset', image: section.settings.image2 %}"
                    sizes="50vw"
                    src="{{ section.settings.image2 | image_url: width: 2048 }}"
                    alt="{{ section.settings.image2.alt | escape }}"
                    width="{{ section.settings.image2.width }}"
                    height="{{ section.settings.image2.height }}"
                    loading="lazy"
                    class="media hidden≤767 image-overlay"
                    style="opacity: 0; --focal-point-x: {{ section.settings.image2.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image2.presentation.focal_point.y }}%"
                    >
                {% endif %}
                {%- if section.settings.image_alter2 -%}
                    <img
                    srcset="{% render 'image-srcset', image: section.settings.image_alter2 %}"
                    sizes="100vw"
                    src="{{ section.settings.image_alter2 | image_url: width: 2048 }}"
                    alt="{{ section.settings.image_alter2.alt | escape }}"
                    width="{{ section.settings.image_alter2.width }}"
                    height="{{ section.settings.image_alter2.height }}"
                    loading="lazy"
                    class="media hidden≥768 image-overlay"
                    style="opacity: 0; --focal-point-x: {{ section.settings.image_alter2.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image_alter2.presentation.focal_point.y }}%"
                    >
        
                {%- elsif section.settings.image2 != blank -%}
                    <img
                    srcset="{% render 'image-srcset', image: section.settings.image2 %}"
                    sizes="100vw"
                    src="{{ section.settings.image2 | image_url: width: 2048 }}"
                    alt="{{ section.settings.image2.alt | escape }}"
                    width="{{ section.settings.image2.width }}"
                    height="{{ section.settings.image2.height }}"
                    loading="lazy"
                    class="media hidden≥768 image-overlay"
                    style="opacity: 0; --focal-point-x: {{ section.settings.image2.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image2.presentation.focal_point.y }}%"
                    >
                {%- endif -%}
            </div>
            <div class="slider-container">
                <span class="label typography--body-regular">Indoor</span>
                <input type="range" min="0" max="100" value="0" class="image-range-slider" id="rangeSlider" aria-label="Image transition">
                <span class="label typography--body-regular">Outdoor</span>
            </div>
        </div>

    </div>

    <div class="banner-content">
      {%- if section.settings.title != blank -%}
        <h2 class="banner-title typography--heading-1">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.paragraph != blank -%}
        <div class="banner-paragraph typography--body-regular">
          {{ section.settings.paragraph
          |  replace: "<h1", "<h1 class='h1 typography--heading-1'"
          |  replace: "<h2", "<h2 class='h2 typography--heading-2'"
          |  replace: "<strong", "<strong class='typography--body-regular-bold'"
          |  replace: "<a", "<a class='link link--inline-block link--hover-color-change'"
            }}
        </div>
      {%- endif -%}

      <div class="color-buttons">
          <div class="color-btn typography--body-regular">
            {% if section.settings.color_icon1 %}
              <img
                src="{{ section.settings.color_icon1 | image_url: width: 1024 }}"
                alt="{{ section.settings.color_icon1.alt | escape }}"
                width="{{ section.settings.color_icon1.width }}"
                height="{{ section.settings.color_icon1.height }}"
                class="color-btn__icon media"
                loading="lazy"
                style="--focal-point-x: {{ section.settings.color_icon1.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.color_icon1.presentation.focal_point.y }}%"
              >
            {% endif %}
            <span class="color-btn__label">{{ section.settings.color1 }}</span>
          </div>
          <div class="color-btn typography--body-regular">
            {% if section.settings.color_icon2 %}
              <img
                src="{{ section.settings.color_icon2 | image_url: width: 1024 }}"
                alt="{{ section.settings.color_icon2.alt | escape }}"
                width="{{ section.settings.color_icon2.width }}"
                height="{{ section.settings.color_icon2.height }}"
                class="color-btn__icon media"
                loading="lazy"
                style="--focal-point-x: {{ section.settings.color_icon2.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.color_icon2.presentation.focal_point.y }}%"
              >
            {% endif %}
            <span class="color-btn__label">{{ section.settings.color2 }}</span>
          </div>        
      </div>
      


    </div>
  </div>
</div>

{% style %}
  .image-transition-slider-50-50-{{ section.id }}{
    {% if section.settings.show_border_top %}
        border-top: .1rem solid rgb(var(--color-grey));
    {% endif %}
    {% if section.settings.show_border_bottom %}
        border-bottom: .1rem solid rgb(var(--color-grey));
    {% endif %}
  }

  .image-transition-slider-50-50-{{ section.id }} .banner-content{
    background-color: {{ section.settings.background_color }};
  }

  .image-transition-slider-50-50-{{ section.id }} .banner-content > * {
    max-width: {{ section.settings.text_max_width }}px;
  }

  .image-transition-slider-50-50-{{ section.id }} .banner-title,
  .image-transition-slider-50-50-{{ section.id }} .banner-paragraph{
    color: {{ section.settings.text_color }}
  }

  @media screen and (min-width: 992px) {
    .image-transition-slider-50-50-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .image-transition-slider-50-50-{{ section.id }} .banner{
      flex-direction: {{ section.settings.flex_direction }};
    }
    .image-transition-slider-50-50-{{ section.id }} .banner-content{
      display: grid;
      justify-content: {{ section.settings.text_placement_hor }};
      align-content: {{ section.settings.text_placement_vert }};
      justify-items: {{ section.settings.text_alignment }};
      text-align: {{ section.settings.text_alignment }};
    }
  }

  @media only screen and (max-width: 991px) {
    .image-transition-slider-50-50-{{ section.id }}{
      padding-top: {{ section.settings.padding_top_alter }}px;
      padding-bottom: {{ section.settings.padding_bottom_alter }}px;
    }
    .image-transition-slider-50-50-{{ section.id }} .banner{
      flex-direction: {{ section.settings.flex_direction_alter }};
    }
    .image-transition-slider-50-50-{{ section.id }} .banner-content{
      display: grid;
      justify-content: {{ section.settings.text_placement_hor_alter }};
      justify-items: {{ section.settings.text_alignment_alter }};
      text-align: {{ section.settings.text_alignment_alter }};
    }
    .image-transition-slider-50-50-{{ section.id }} .banner-content > * {
      max-width: 100%;
    }
  }
{% endstyle %}


<script>
    document.addEventListener("DOMContentLoaded", function () {
    const slider = document.getElementById("rangeSlider");
    const overlayImages = document.querySelectorAll(".image-container-2 .media");

    slider.addEventListener("input", function () {
        const opacity = parseInt(this.value, 10) / 100;

        overlayImages.forEach(img => {
        img.style.opacity = opacity;
        });
    });
    });

</script>
{% schema %}
{
  "name": "Image Transition Slider",
  "tag": "section",
  "class": "section--image-transition-slider-50-50",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
        "type": "checkbox",
        "id": "show_border_top",
        "label": "Show Border Top",
        "default": false
    },
    {
        "type": "checkbox",
        "id": "show_border_bottom",
        "label": "Show Border Bottom",
        "default": false
    },
    {
      "type": "header",
      "content": "Media 1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_alter",
      "label": "Image 1 (Mobile)"
    },
    {
      "type": "header",
      "content": "Media 2"
    },
    {
      "type": "image_picker",
      "id": "image2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_alter2",
      "label": "Image 2 (Mobile)"
    },
    {
      "type": "header",
      "content": "Media Position"
    },
    {
      "type": "radio",
      "id": "flex_direction",
      "label": "Media Position",
      "options": [
        {
          "value": "row",
          "label": "Left"
        },
        {
          "value": "row-reverse",
          "label": "Right"
        }
      ],
      "default": "row"
    },
    {
      "type": "radio",
      "id": "flex_direction_alter",
      "label": "Media Position (Mobile)",
      "options": [
        {
          "value": "column",
          "label": "Top"
        },
        {
          "value": "column-reverse",
          "label": "Bottom"
        }
      ],
      "default": "column"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph"
    },
    {
      "type": "text",
      "id": "color1",
      "label": "Color name-1"
    },
    {
      "type": "image_picker",
      "id": "color_icon1",
      "label": "Color icon-1"
    },
    {
      "type": "text",
      "id": "color2",
      "label": "Color name-2"
    },
    {
      "type": "image_picker",
      "id": "color_icon2",
      "label": "Color icon-2"
    },
    {
      "type": "range",
      "id": "text_max_width",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Text Max Width",
      "default": 400
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#201F1E"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F8F8F8"
    },
    {
      "type": "radio",
      "id": "text_placement_hor",
      "label": "Text Placement Horizontal",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_placement_vert",
      "label": "Text Placement Vertical",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_placement_hor_alter",
      "label": "Text Placement Horizontal (Mobile)",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_alignment_alter",
      "label": "Text Alignment (Mobile)",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image Transition Slider"
    }
  ]
}
{% endschema %}