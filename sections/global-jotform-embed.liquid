<div class="jotform-wrapper" style="max-width: 100%;">
  <iframe
    src="{{ section.settings.iframe_url }}"
    frameborder="0"
    style="width: 100%; height: {{ section.settings.height }}px;"
    allowfullscreen
  >
  </iframe>
</div>

{% schema %}
{
  "name": "JotForm Embed",
  "tag": "section",
  "class": "section--jotform-embed",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "iframe_url",
      "label": "JotForm Embed URL",
      "default": "https://form.jotform.com/YOUR_FORM_ID"
    },
    {
      "type": "text",
      "id": "height",
      "label": "Form Height (px)",
      "default": "800"
    }
  ],
  "presets": [
    {
      "name": "JotForm Embed"
    }
  ]
}
{% endschema %}
