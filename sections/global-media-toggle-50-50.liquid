    {
      "type": "radio",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_placement_hor_alter",
      "label": "Text Placement Horizontal (Mobile)",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_alignment_alter",
      "label": "Text Alignment (Mobile)",
      "options": [
        {
          "value": "start",
