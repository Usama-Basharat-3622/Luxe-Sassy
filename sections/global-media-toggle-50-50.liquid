{{ 'section-media-toggle-50-50.css' | asset_url | stylesheet_tag }}

<div
  id="media-toggle-50-50-{{ section.id }}"
  class="media-toggle-50-50-{{ section.id }} media-toggle-50-50 isolate"
>
  <div class="banner banner">
    <div class="banner-media">
      <div class="banner-media-content main-media active-media" id="default-image">
        {%- case section.settings.media_type -%}
          {%- when 'image' -%}
            {% if section.settings.image != blank %}
              <img
                srcset="{% render 'image-srcset', image: section.settings.image %}"
                sizes="50vw"
                src="{{ section.settings.image | image_url: width: 2048 }}"
                alt="{{ section.settings.image.alt | escape }}"
                width="{{ section.settings.image.width }}"
                height="{{ section.settings.image.height }}"
                loading="eager"
                class="media hidden≤767"
                style="--focal-point-x: {{ section.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image.presentation.focal_point.y }}%"
              >
            {% endif %}
            {%- if section.settings.image_alter -%}
              <img
                srcset="{% render 'image-srcset', image: section.settings.image_alter %}"
                sizes="100vw"
                src="{{ section.settings.image_alter | image_url: width: 2048 }}"
                alt="{{ section.settings.image_alter.alt | escape }}"
                width="{{ section.settings.image_alter.width }}"
                height="{{ section.settings.image_alter.height }}"
                loading="eager"
                class="media hidden≥768"
                style="--focal-point-x: {{ section.settings.image_alter.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image_alter.presentation.focal_point.y }}%"
              >

            {%- elsif section.settings.image != blank -%}
              <img
                srcset="{% render 'image-srcset', image: section.settings.image %}"
                sizes="100vw"
                src="{{ section.settings.image | image_url: width: 2048 }}"
                alt="{{ section.settings.image.alt | escape }}"
                width="{{ section.settings.image.width }}"
                height="{{ section.settings.image.height }}"
                loading="eager"
                class="media hidden≥768"
                style="--focal-point-x: {{ section.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image.presentation.focal_point.y }}%"
              >
            {%- endif -%}
          {%- when 'video' -%}
            {% if section.settings.video != blank %}
              <video
                alt="{{ section.settings.video.alt | escape }}"
                width="{{ section.settings.video.preview_image.width }}"
                height="{{ section.settings.video.preview_image.height }}"
                autoplay
                playsinline
                muted
                loop
                preload="false"
                loading="eager"
                class="media hidden≤767"
              >
                {% for source in section.settings.video.sources %}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {% endfor %}
              </video>
            {% endif %}
            {%- if section.settings.video_alter -%}
              <video
                alt="{{ section.settings.video_alter.alt | escape }}"
                width="{{ section.settings.video_alter.preview_image.width }}"
                height="{{ section.settings.video_alter.preview_image.height }}"
                autoplay
                playsinline
                muted
                loop
                preload="false"
                loading="eager"
                class="media hidden≥768"
              >
                {% for source in section.settings.video_alter.sources %}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {% endfor %}
              </video>

            {%- elsif section.settings.video != blank -%}
              <video
                alt="{{ section.settings.video.alt | escape }}"
                width="{{ section.settings.video.preview_image.width }}"
                height="{{ section.settings.video.preview_image.height }}"
                autoplay
                playsinline
                muted
                loop
                preload="false"
                loading="eager"
                class="media hidden≥768"
              >
                {% for source in section.settings.video.sources %}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {% endfor %}
              </video>
            {%- endif -%}
        {%- endcase -%}
      </div>
      {% for block in section.blocks %}
        <div class="banner-media-content main-media" id="media-{{ forloop.index }}" style="display: none;">
          {%- case block.settings.media_type -%}
            {%- when 'image' -%}
              {% if block.settings.image != blank %}
                <img
                  srcset="{% render 'image-srcset', image: block.settings.image %}"
                  sizes="50vw"
                  src="{{ block.settings.image | image_url: width: 2048 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="eager"
                  class="media hidden≤767"
                  style="--focal-point-x: {{ block.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ block.settings.image.presentation.focal_point.y }}%"
                >
              {% endif %}
              {%- if block.settings.image_alter -%}
                <img
                  srcset="{% render 'image-srcset', image: block.settings.image_alter %}"
                  sizes="100vw"
                  src="{{ block.settings.image_alter | image_url: width: 2048 }}"
                  alt="{{ block.settings.image_alter.alt | escape }}"
                  width="{{ block.settings.image_alter.width }}"
                  height="{{ block.settings.image_alter.height }}"
                  loading="eager"
                  class="media hidden≥768"
                  style="--focal-point-x: {{ block.settings.image_alter.presentation.focal_point.x }}%; --focal-point-y: {{ block.settings.image_alter.presentation.focal_point.y }}%"
                >

              {%- elsif block.settings.image != blank -%}
                <img
                  srcset="{% render 'image-srcset', image: block.settings.image %}"
                  sizes="100vw"
                  src="{{ block.settings.image | image_url: width: 2048 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="eager"
                  class="media hidden≥768"
                  style="--focal-point-x: {{ block.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ block.settings.image.presentation.focal_point.y }}%"
                >
              {%- endif -%}
            {%- when 'video' -%}
              {% if block.settings.video != blank %}
                <video
                  alt="{{ block.settings.video.alt | escape }}"
                  width="{{ block.settings.video.preview_image.width }}"
                  height="{{ block.settings.video.preview_image.height }}"
                  autoplay
                  playsinline
                  muted
                  loop
                  preload="false"
                  loading="eager"
                  class="media hidden≤767"
                >
                  {% for source in block.settings.video.sources %}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {% endfor %}
                </video>
              {% endif %}
              {%- if block.settings.video_alter -%}
                <video
                  alt="{{ block.settings.video_alter.alt | escape }}"
                  width="{{ block.settings.video_alter.preview_image.width }}"
                  height="{{ block.settings.video_alter.preview_image.height }}"
                  autoplay
                  playsinline
                  muted
                  loop
                  preload="false"
                  loading="eager"
                  class="media hidden≥768"
                >
                  {% for source in block.settings.video_alter.sources %}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {% endfor %}
                </video>

              {%- elsif block.settings.video != blank -%}
                <video
                  alt="{{ block.settings.video.alt | escape }}"
                  width="{{ block.settings.video.preview_image.width }}"
                  height="{{ block.settings.video.preview_image.height }}"
                  autoplay
                  playsinline
                  muted
                  loop
                  preload="false"
                  loading="eager"
                  class="media hidden≥768"
                >
                  {% for source in block.settings.video.sources %}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {% endfor %}
                </video>
              {%- endif -%}
          {%- endcase -%}
        </div>
      {% endfor %}
    </div>

    <div class="banner-content">
      {%- if section.settings.title != blank -%}
        <h2 class="banner-title typography--heading-1">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.paragraph != blank -%}
        <div class="banner-paragraph typography--body-regular">
          {{
            section.settings.paragraph
            | replace: '<h1', "<h1 class='h1 typography--heading-1'"
            | replace: '<h2', "<h2 class='h2 typography--heading-2'"
            | replace: '<strong', "<strong class='typography--body-regular-bold'"
            | replace: '<a', "<a class='link link--inline-block link--hover-color-change'"
          }}
        </div>
      {%- endif -%}

      <div class="color-buttons">
        {% for block in section.blocks %}
          <button
            class="color-btn link link--inline-block link--hover-color-change"
            data-media-id="media-{{ forloop.index }}"
            aria-label="Select {{ block.settings.color | escape }} media"
          >
            {% if block.settings.color_icon %}
              <img
                src="{{ block.settings.color_icon | image_url: width: 60 }}"
                alt="{{ block.settings.color_icon.alt | escape }}"
                class="color-btn__icon media"
                width="60"
                height="40"
                loading="lazy"
              >
            {% endif %}
            <span class="color-btn__label">{{ block.settings.color }}</span>
          </button>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% style %}
  .media-toggle-50-50-{{ section.id }}{
    {% if section.settings.show_border_top %}
        border-top: .1rem solid rgb(var(--color-grey));
    {% endif %}
    {% if section.settings.show_border_bottom %}
        border-bottom: .1rem solid rgb(var(--color-grey));
    {% endif %}
  }

  .media-toggle-50-50-{{ section.id }} .banner-content{
    background-color: {{ section.settings.background_color }};
  }

  .media-toggle-50-50-{{ section.id }} .banner-content > * {
    max-width: {{ section.settings.text_max_width }}px;
  }

  .media-toggle-50-50-{{ section.id }} .banner-title,
  .media-toggle-50-50-{{ section.id }} .banner-paragraph{
    color: {{ section.settings.text_color }}
  }
  .media-toggle-50-50-{{ section.id }} .color-btn.active{
    color: rgb(var(--color-text-active));
  }

  @media screen and (min-width: 992px) {
    .media-toggle-50-50-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .media-toggle-50-50-{{ section.id }} .banner{
      flex-direction: {{ section.settings.flex_direction }};
    }
    .media-toggle-50-50-{{ section.id }} .banner-content{
      display: grid;
      justify-content: {{ section.settings.text_placement_hor }};
      align-content: {{ section.settings.text_placement_vert }};
      justify-items: {{ section.settings.text_alignment }};
      text-align: {{ section.settings.text_alignment }};
    }
  }

  @media only screen and (max-width: 991px) {
    .media-toggle-50-50-{{ section.id }}{
      padding-top: {{ section.settings.padding_top_alter }}px;
      padding-bottom: {{ section.settings.padding_bottom_alter }}px;
    }
    .media-toggle-50-50-{{ section.id }} .banner{
      flex-direction: {{ section.settings.flex_direction_alter }};
    }
    .media-toggle-50-50-{{ section.id }} .banner-content{
      display: grid;
      justify-content: {{ section.settings.text_placement_hor_alter }};
      justify-items: {{ section.settings.text_alignment_alter }};
      text-align: {{ section.settings.text_alignment_alter }};
    }
    .media-toggle-50-50-{{ section.id }} .banner-content > * {
      max-width: 100%;
    }
  }
{% endstyle %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const buttons = document.querySelectorAll('.color-btn');
    const allMedia = document.querySelectorAll('.main-media');

    buttons.forEach((button) => {
      button.addEventListener('click', function () {
        const mediaId = this.getAttribute('data-media-id');

        // Hide all media
        allMedia.forEach((el) => (el.style.display = 'none'));

        // Show selected media
        const target = document.getElementById(mediaId);
        if (target) {
          target.style.display = 'block';
        }
        buttons.forEach((btn) => btn.classList.remove('active'));
        // Add 'active' to the clicked button
        this.classList.add('active');
      });
    });
  });
</script>

{% schema %}
{
  "name": "Media Toggle 50-50",
  "tag": "section",
  "class": "section--media-toggle-50-50",
  "max_blocks": 4,
  "enabled_on": {
    "templates": ["page", "index"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_border_top",
      "label": "Show Border Top",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_border_bottom",
      "label": "Show Border Bottom",
      "default": false
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "radio",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Default Image"
    },
    {
      "type": "image_picker",
      "id": "image_alter",
      "label": "Default Image (Mobile)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Default Video"
    },
    {
      "type": "video",
      "id": "video_alter",
      "label": "Default Video (Mobile)"
    },
    {
      "type": "header",
      "content": "Media Position"
    },
    {
      "type": "radio",
      "id": "flex_direction",
      "label": "Media Position",
      "options": [
        {
          "value": "row",
          "label": "Left"
        },
        {
          "value": "row-reverse",
          "label": "Right"
        }
      ],
      "default": "row"
    },
    {
      "type": "radio",
      "id": "flex_direction_alter",
      "label": "Media Position (Mobile)",
      "options": [
        {
          "value": "column",
          "label": "Top"
        },
        {
          "value": "column-reverse",
          "label": "Bottom"
        }
      ],
      "default": "column"
