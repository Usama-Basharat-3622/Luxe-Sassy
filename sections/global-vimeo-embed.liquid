<div
  class="vimeo-video-row page-width"
  style="padding-top: {{ section.settings.padding_top | default: 40 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;"
>
  {% for block in section.blocks %}
    {% if block.settings.vimeo_url != blank %}
      <div class="vimeo-video-block">
        <div class="vimeo-video">
          <iframe
            src="{{ block.settings.vimeo_url }}"
            frameborder="0"
            allowfullscreen
            allow="autoplay; fullscreen"
          ></iframe>
        </div>
        {% if block.settings.video_title != blank %}
          <h3 class="vimeo-video-title">{{ block.settings.video_title }}</h3>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>

<style>
  .vimeo-video-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }

  .vimeo-video-block {
    flex: 1 1 calc(25% - 24px);
    max-width: 320px;
    text-align: center;
  }

  .vimeo-video {
    aspect-ratio: 16 / 9;
  }

  .vimeo-video iframe {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 767px) {
    .vimeo-video-block {
      flex: none;
      max-width: none;
      width: 92%;
    }
  }
</style>

{% schema %}
{
  "name": "Global Vimeo Video Row",
  "tag": "section",
  "class": "section--vimeo-embed",
  "max_blocks": 4,
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Vimeo Video",
      "settings": [
        {
          "type": "url",
          "id": "vimeo_url",
          "label": "Vimeo Embed URL",
          "info": "Use a URL like https://player.vimeo.com/video/716891710"
        },
        {
          "type": "text",
          "id": "video_title",
          "label": "Video Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Global Vimeo Video Row"
    }
  ]
}
{% endschema %}
