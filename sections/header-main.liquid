  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Main Menu"
    },
    {
      "type": "link_list",
      "id": "main_menu_desktop",
      "default": "main-menu",
      "label": "Main Menu Desktop"
    },
    {
      "type": "link_list",
      "id": "main_menu_mobile",
      "label": "Main Menu Mobile"
    },
    {
      "type": "header",
      "content": "Side Menu"
    },
    {
      "type": "link_list",
      "id": "side_menu_top_mobile",
      "label": "Side Menu Top Mobile"
    },
    {
      "type": "link_list",
      "id": "side_menu_bottom_mobile",
      "label": "Side Menu Bottom Mobile"
    },
    {
      "type": "header",
      "content": "Mini Menu"
    },
    {
      "type": "link_list",
      "id": "mini_menu_mobile",
      "label": "Mini Menu Mobile"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 Title"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu 2 Title"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    },
    {
      "type": "richtext",
