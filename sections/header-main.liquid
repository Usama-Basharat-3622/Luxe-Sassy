{{ 'header-main.css' | asset_url | stylesheet_tag }}

<!-- Header Main -->
<div id="header-main" class="header-main isolate" data-id="{{ section.id }}">
  <div id="header-main-line" class="header-main-line">
    <!-- Logo -->
    {%- if request.page_type == 'index' -%}
      <h1 class="header-logo">
    {%- else -%}
      <div class="header-logo">
    {%- endif -%}
    <a href="{{ routes.root_url }}" class="header-logo-link link link--block">
      <img
        srcset="{% render 'image-srcset', image: settings.logo_png %}"
        sizes="50vw"
        src="{{ settings.logo_png | image_url }}"
        alt="{{ settings.logo_png.alt | escape }}"
        width="{{ settings.logo_png.width }}"
        height="{{ settings.logo_png.height }}"
        class="media icon"
        style="--focal-point-x: {{ settings.logo_png.presentation.focal_point.x }}%; --focal-point-y: {{ settings.logo_png.presentation.focal_point.y }}%"
      >
      <span class="visually-hidden">{{ shop.name }}</span>
    </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- else -%}
      </div>
    {%- endif -%}

    <!-- Mega Menu -->
    {% render 'header-mega' %}

    <!-- Side Menu -->
    <ul class="header-side-menu" role="navigation">
      <!-- Search -->
      <li class="header-side-menu-item hidden-header-drawer-open">
        {% render 'header-search' %}
      </li>
      <!-- Account -->
      <li class="header-side-menu-item hidden-header-drawer-open">
        <a
          href="{{ section.settings.cta_link }}"
          class=""
        >
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      </li>
      <!-- Cart -->
      <li class="header-side-menu-item hidden-header-drawer-open">
        <a
          id="cart-icon-bubble"
          class="header-side-menu-link cart-icon-bubble link link--block link--hover-color-change"
          href="{{ routes.cart_url }}"
        >
          {{- 'icon-bag.svg' | inline_asset_content -}}
          <span class="visually-hidden">{{ 'header.bag_toggle_label' | t }}</span>
          {%- if cart != empty -%}
            <div class="cart-count-bubble">
              {%- if cart.item_count < 100 -%}
                <span aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
              <span class="visually-hidden">{{ 'header.bag_toggle_cart_count' | t: count: cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>
      </li>
      <!-- Menu -->
      <li class="header-side-menu-item hidden≥1025">
        {% render 'header-drawer' %}
      </li>
    </ul>
  </div>
  <!-- Mini Menu -->
  <ul class="header-mini-menu scrollbar-hidden hidden≥1025" role="navigation">
    {%- for link in section.settings.mini_menu_mobile.links -%}
      <li class="header-mini-menu-item">
        <a
          href="{{ link.url }}"
          class="header-mini-menu-link link link--block link--hover-color-change typography--navigation"
        >
          {{ link.title | escape }}
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "logo": {{ settings.logo_png | image_url: width: 500 | prepend: "https:" | json }},
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
