      "label": "Richtext"
    },
    {
      "type": "text",
      "id": "product_list_title",
      "label": "Products Title"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 2
    }
  ]
}
{% endschema %}
