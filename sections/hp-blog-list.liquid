{{ 'hp-blog-list.css' | asset_url | stylesheet_tag }}

<div
  id="hp-blog-list-{{ section.id }}"
  class="hp-blog-list-{{ section.id }} hp-blog-list isolate"
>
  <div class="hp-blog-list-header">
    <h2 class="hp-blog-list-title typography--heading-1">{{ section.settings.title }}</h2>
    <a
      href="{{ section.settings.cta_link }}"
      class="hp-blog-list-cta link button button--tertiary typography--body-regular"
    >
      {{- section.settings.cta_text -}}
      {{ 'icon-arrow-full_upright.svg' | inline_asset_content }}
    </a>
  </div>

  <hp-blog-carousel class="hp-blog-carousel" role="region">
    <div class="swiper isolate">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="hp-blog-card-{{ block.id }} hp-blog-card">
              <div class="hp-blog-card-top">
                <img
                  srcset="{% render 'image-srcset', image: block.settings.article.metafields.custom.cover_image %}"
                  sizes="(min-width: 992px) calc( 100vw / {{ section.blocks.size }} ), 50vw"
                  src="{{ block.settings.article.metafields.custom.cover_image | image_url: width: 2048 }}"
                  alt="{{ block.settings.article.metafields.custom.cover_image.alt | escape }}"
                  width="{{ block.settings.article.metafields.custom.cover_image.width }}"
                  height="{{ block.settings.article.metafields.custom.cover_image.height }}"
                  loading="lazy"
                  fetchpriority="low"
                  class="media"
                  style="--focal-point-x: {{ block.settings.article.metafields.custom.cover_image.presentation.focal_point.x }}%; --focal-point-y: {{ block.settings.article.metafields.custom.cover_image.presentation.focal_point.y }}%"
                >
                <a
                  class="link link--covering focus-none"
                  href="{{ block.settings.article.url }}"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <span class="visually-hidden">{{ block.settings.cta_text }}</span>
                </a>
              </div>
              <div class="hp-blog-card-bottom">
                <div class="hp-blog-card-date typography--body-small">
                  {{ block.settings.article.published_at | date: '%m.%d.%Y' }}
                </div>
                <h3 class="hp-blog-card-title typography--body-regular">
                  <a href="{{ block.settings.article.url }}" class="link link--hover-color-change">
                    {{- block.settings.article.title -}}
                  </a>
                </h3>
                <div class="hp-blog-card-excerpt typography--body-small hidden≤767">
                  {{ block.settings.article.excerpt }}
                </div>
                <a
                  href="{{ block.settings.article.url }}"
                  class="hp-blog-card-link link link--underline link--hover-color-change typography--navigation hidden≤767"
                >
                  {{ block.settings.cta_text }}
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="swiper-scrollbar hidden≥1200"></div>
    </div>
  </hp-blog-carousel>
</div>

{% style %}
  @media screen and (min-width: 768px) {
    .hp-blog-list-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media only screen and (max-width: 767px) {
    .hp-blog-list-{{ section.id }}{
      padding-top: {{ section.settings.padding_top_alter }}px;
      padding-bottom: {{ section.settings.padding_bottom_alter }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "HP Blog List",
  "tag": "section",
  "class": "section--hp-blog-list",
  "max_blocks": 4,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "name": "Block",
      "type": "block",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Text",
          "default": "Keep reading"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP Blog List"
    }
  ]
}
{% endschema %}
