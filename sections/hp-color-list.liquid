{{ 'hp-color-list.css' | asset_url | stylesheet_tag }}

<div
  id="hp-color-list-{{ section.id }}"
  class="hp-color-list-{{ section.id }} hp-color-list isolate"
>
  <div class="hp-color-list-header">
    <div class="hp-color-list-header-text">
      {%- if section.settings.title != blank -%}
        <h2 class="hp-color-list-title typography--heading-1">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="hp-color-list-text">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>
    {%- if section.settings.cta_text != blank -%}
      <a
        href="{{ section.settings.cta_link }}"
        class="hp-color-list-cta link button button--tertiary typography--body-regular"
      >
        {{- section.settings.cta_text -}}
        {{ 'icon-arrow-full_upright.svg' | inline_asset_content }}
      </a>
    {%- endif -%}
  </div>

  <hp-color-carousel class="hp-color-carousel" role="region">
    <div class="swiper isolate">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="hp-color-card-{{ block.id }} hp-color-card">
              <div class="ratio ratio--1-1">
                <div class="hp-color-card-swatch">
                  <div class="ratio ratio--1-1">
                    <span class="visually-hidden">{{ block.settings.title }}</span>
                  </div>
                </div>
                <a
                  href="{{ block.settings.color_link }}"
                  class="link hp-color-card-tag typography--tag"
                >
                  {{- block.settings.title -}}
                </a>
              </div>
              <a
                class="link link--covering"
                href="{{ block.settings.color_link }}"
                tabindex="-1"
                aria-hidden="true"
              >
                <span class="visually-hidden">{{ 'accessibility.link_to_item' | t: item: block.settings.title }}</span>
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="swiper-scrollbar hidden≥992"></div>
    </div>
  </hp-color-carousel>
</div>

{% style %}
  {%- for block in section.blocks -%}

  .hp-color-list-{{ section.id }} .hp-color-card-{{ block.id }} .hp-color-card-swatch {
    background-color: {{ block.settings.hex }};
  }

  {%- endfor -%}

  @media screen and (min-width: 768px) {
    .hp-color-list-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media only screen and (max-width: 767px) {
    .hp-color-list-{{ section.id }}{
      padding-top: {{ section.settings.padding_top_alter }}px;
      padding-bottom: {{ section.settings.padding_bottom_alter }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "HP Color Carousel",
  "tag": "section",
  "class": "section--hp-color-list",
  "max_blocks": 24,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "name": "Color",
      "type": "color",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Color Title"
        },
        {
          "type": "color",
          "id": "hex",
          "label": "Color Hex"
        },
        {
          "type": "url",
          "id": "color_link",
          "label": "Color Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP Color List"
    }
  ]
}
{% endschema %}
