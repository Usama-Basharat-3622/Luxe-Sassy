{{ 'hp-editorial-100.css' | asset_url | stylesheet_tag }}

<div
  id="hp-editorial-100-{{ section.id }}"
  class="hp-editorial-100-{{ section.id }} hp-editorial-100 isolate"
>
  <div class="hp-banner banner">
    {%- case section.settings.media_type -%}
      {%- when 'image' -%}
        <img
          srcset="{% render 'image-srcset', image: section.settings.image %}"
          sizes="50vw"
          src="{{ section.settings.image | image_url: width: 2048 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
          fetchpriority="low"
          class="media hidden≤767"
          style="--focal-point-x: {{ section.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image.presentation.focal_point.y }}%"
        >

        <img
          srcset="{% render 'image-srcset', image: section.settings.image_alter %}"
          sizes="100vw"
          src="{{ section.settings.image_alter | image_url: width: 2048 }}"
          alt="{{ section.settings.image_alter.alt | escape }}"
          width="{{ section.settings.image_alter.width }}"
          height="{{ section.settings.image_alter.height }}"
          loading="lazy"
          fetchpriority="low"
          class="media hidden≥768"
          style="--focal-point-x: {{ section.settings.image_alter.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image_alter.presentation.focal_point.y }}%"
        >
      {%- when 'video' -%}
        <video
          alt="{{ section.settings.video.alt | escape }}"
          width="{{ section.settings.video.preview_image.width }}"
          height="{{ section.settings.video.preview_image.height }}"
          autoplay
          playsinline
          muted
          loop
          preload="auto"
          loading="eager"
          class="media hidden≤767"
        >
          {% for source in section.settings.video.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>

        <video
          alt="{{ section.settings.video_alter.alt | escape }}"
          width="{{ section.settings.video_alter.preview_image.width }}"
          height="{{ section.settings.video_alter.preview_image.height }}"
          autoplay
          playsinline
          muted
          loop
          preload="auto"
          loading="eager"
          class="media hidden≥768"
        >
          {% for source in section.settings.video_alter.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>
    {%- endcase -%}

    <div class="banner-content banner-overlay">
      {%- if section.settings.subtitle != blank -%}
        <h3 class="banner-subtitle typography--tag">
          {{ section.settings.subtitle }}
        </h3>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="banner-title typography--heading-1">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.paragraph != blank -%}
        <div class="banner-paragraph typography--body-regular">
          {{ section.settings.paragraph }}
        </div>
      {%- endif -%}
      {%- if section.settings.cta_1_text != blank and section.settings.cta_2_text != blank -%}
        <div class="banner-cta-line">
          {%- if section.settings.cta_1_text != blank -%}
            <a
              href="{{ section.settings.cta_1_link }}"
              class="banner-cta link button button--tag-big typography--cta"
            >
              {{- section.settings.cta_1_text -}}
            </a>
          {%- endif -%}
          {%- if section.settings.cta_2_text != blank -%}
            <a
              href="{{ section.settings.cta_2_link }}"
              class="banner-cta link button button--tag-big typography--cta"
            >
              {{- section.settings.cta_2_text -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .hp-editorial-100-{{ section.id }} .banner-overlay {
    background-color: rgba(0,0,0,0.{{ section.settings.overlay_opacity }});
  }

  @media screen and (min-width: 992px) {
    .hp-editorial-100-{{ section.id }} .banner-content{
      display: grid;
      gap: 1.6rem;
      justify-content: {{ section.settings.text_placement_hor }};
      align-content: {{ section.settings.text_placement_vert }};
      justify-items: {{ section.settings.text_alignment }};
      text-align: {{ section.settings.text_alignment }};
    }
  }

  @media only screen and (max-width: 991px) {
    .hp-editorial-100-{{ section.id }} .banner-content{
      display: grid;
      gap: 1.6rem;
      justify-content: {{ section.settings.text_placement_hor_alter }};
      align-content: {{ section.settings.text_placement_vert_alter }};
      justify-items: {{ section.settings.text_alignment_alter }};
      text-align: {{ section.settings.text_alignment_alter }};
    }
  }


  .hp-editorial-100-{{ section.id }} .banner-subtitle,
  .hp-editorial-100-{{ section.id }} .banner-title,
  .hp-editorial-100-{{ section.id }} .banner-paragraph{
    color: {{ section.settings.text_color }}
  }

  .hp-editorial-100-{{ section.id }} .banner-cta{
    color: {{ section.settings.cta_color }};
  }


  @media screen and (min-width: 992px) {
    .hp-editorial-100-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media only screen and (max-width: 991px) {
    .hp-editorial-100-{{ section.id }}{
      padding-top: {{ section.settings.padding_top_alter }}px;
      padding-bottom: {{ section.settings.padding_bottom_alter }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "HP Editorial 100",
  "tag": "section",
  "class": "section--hp-editorial-100",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "radio",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_alter",
      "label": "Image (Mobile)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "video",
      "id": "video_alter",
      "label": "Video (Mobile)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "Overlay Opacity",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "SubTitle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph"
    },
    {
      "type": "text",
      "id": "cta_1_text",
      "label": "CTA 1 Text"
    },
    {
      "type": "url",
      "id": "cta_1_link",
      "label": "CTA 1 Link"
    },
    {
      "type": "text",
      "id": "cta_2_text",
      "label": "CTA 2 Text"
    },
    {
      "type": "url",
      "id": "cta_2_link",
      "label": "CTA 2 Link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#201F1E"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "CTA Color",
      "default": "#201F1E"
    },
    {
      "type": "radio",
      "id": "text_placement_hor",
      "label": "Text Placement Horizontal",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_placement_vert",
      "label": "Text Placement Vertical",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_placement_hor_alter",
      "label": "Text Placement Horizontal (Mobile)",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },

    {
      "type": "radio",
      "id": "text_placement_vert_alter",
      "label": "Text Placement Vertical (Mobile)",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },

    {
      "type": "radio",
      "id": "text_alignment_alter",
      "label": "Text Alignment (Mobile)",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },

    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "HP Editorial 100"
    }
  ]
}
{% endschema %}
