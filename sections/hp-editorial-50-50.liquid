{{ 'hp-editorial-50-50.css' | asset_url | stylesheet_tag }}

<div
  id="hp-editorial-50-50-{{ section.id }}"
  class="hp-editorial-50-50-{{ section.id }} hp-editorial-50-50 isolate"
>
  <div class="hp-banner banner">
    {%- case section.settings.media_type -%}
      {%- when 'image' -%}
        <img
          srcset="{% render 'image-srcset', image: section.settings.image %}"
          sizes="50vw"
          src="{{ section.settings.image | image_url: width: 2048 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
          fetchpriority="low"
          class="media hidden≤767"
          style="--focal-point-x: {{ section.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image.presentation.focal_point.y }}%"
        >

        <img
          srcset="{% render 'image-srcset', image: section.settings.image_alter %}"
          sizes="100vw"
          src="{{ section.settings.image_alter | image_url: width: 2048 }}"
          alt="{{ section.settings.image_alter.alt | escape }}"
          width="{{ section.settings.image_alter.width }}"
          height="{{ section.settings.image_alter.height }}"
          loading="lazy"
          fetchpriority="low"
          class="media hidden≥768"
          style="--focal-point-x: {{ section.settings.image_alter.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image_alter.presentation.focal_point.y }}%"
        >
      {%- when 'video' -%}
        <video
          alt="{{ section.settings.video.alt | escape }}"
          width="{{ section.settings.video.preview_image.width }}"
          height="{{ section.settings.video.preview_image.height }}"
          autoplay
          playsinline
          muted
          loop
          preload="auto"
          loading="eager"
          class="media hidden≤767"
        >
          {% for source in section.settings.video.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>

        <video
          alt="{{ section.settings.video_alter.alt | escape }}"
          width="{{ section.settings.video_alter.preview_image.width }}"
          height="{{ section.settings.video_alter.preview_image.height }}"
          autoplay
          playsinline
          muted
          loop
          preload="auto"
          loading="eager"
          class="media hidden≥768"
        >
          {% for source in section.settings.video_alter.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>
    {%- endcase -%}

    <div class="banner-content">
      {%- if section.settings.title != blank -%}
        <h2 class="banner-title typography--heading-1">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
      {%- if section.settings.paragraph != blank -%}
        <div class="banner-paragraph typography--body-regular">
          {{ section.settings.paragraph }}
        </div>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a
          href="{{ section.settings.cta_link }}"
          class="banner-cta link button button--tertiary typography--body-regular"
        >
          {{- section.settings.cta_text -}}
          {{ 'icon-arrow-full_upright.svg' | inline_asset_content }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .hp-editorial-50-50-{{ section.id }} .banner-content{
    background-color: {{ section.settings.background_color }};
  }

  .hp-editorial-50-50-{{ section.id }} .banner-title,
  .hp-editorial-50-50-{{ section.id }} .banner-paragraph{
    color: {{ section.settings.text_color }}
  }

  @media screen and (min-width: 992px) {
    .hp-editorial-50-50-{{ section.id }} .banner{
      flex-direction: {{ section.settings.flex_direction }};
    }

    .hp-editorial-50-50-{{ section.id }} .banner-content{
      display: grid;
      justify-content: {{ section.settings.text_placement_hor }};
      align-content: {{ section.settings.text_placement_vert }};
      justify-items: {{ section.settings.text_alignment }};
      text-align: {{ section.settings.text_alignment }};
    }

    .hp-editorial-50-50-{{ section.id }} .banner-content > * {
      max-width: {{ section.settings.text_max_width }}px;
    }
  }

  @media only screen and (max-width: 991px) {
    .hp-editorial-50-50-{{ section.id }} .banner{
      flex-direction: {{ section.settings.flex_direction_alter }};
    }

    .hp-editorial-50-50-{{ section.id }} .banner-content{
      text-align: {{ section.settings.text_alignment_alter }};
    }
  }

  @media screen and (min-width: 992px) {
    .hp-editorial-50-50-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media only screen and (max-width: 991px) {
    .hp-editorial-50-50-{{ section.id }}{
      padding-top: {{ section.settings.padding_top_alter }}px;
      padding-bottom: {{ section.settings.padding_bottom_alter }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "HP Editorial 50-50",
  "tag": "section",
  "class": "section--hp-editorial-50-50",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "radio",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_alter",
      "label": "Image (Mobile)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "video",
      "id": "video_alter",
      "label": "Video (Mobile)"
    },
    {
      "type": "radio",
      "id": "flex_direction",
      "label": "Layout Direction",
      "options": [
        {
          "value": "row",
          "label": "Normal"
        },
        {
          "value": "row-reverse",
          "label": "Reverse"
        }
      ],
      "default": "row"
    },
    {
      "type": "radio",
      "id": "flex_direction_alter",
      "label": "Layout Direction (Mobile)",
      "options": [
        {
          "value": "column",
          "label": "Normal"
        },
        {
          "value": "column-reverse",
          "label": "Reverse"
        }
      ],
      "default": "column"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "range",
      "id": "text_max_width",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Text Max Width",
      "default": 400
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#201F1E"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F8F8F8"
    },
    {
      "type": "radio",
      "id": "text_placement_hor",
      "label": "Text Placement Horizontal",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_placement_vert",
      "label": "Text Placement Vertical",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_alignment_alter",
      "label": "Text Alignment (Mobile)",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "HP Editorial 50-50"
    }
  ]
}
{% endschema %}
