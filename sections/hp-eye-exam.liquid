{{ 'hp-eye-exam.css' | asset_url | stylesheet_tag }}

<div
  id="hp-eye-exam-{{ section.id }}"
  class="hp-eye-exam-{{ section.id }} hp-eye-exam isolate"
>
  <div class="hp-banner banner">
    {%- case section.settings.media_type -%}
      {%- when 'image' -%}
        <img
          srcset="{% render 'image-srcset', image: section.settings.image %}"
          sizes="50vw"
          src="{{ section.settings.image | image_url: width: 2048 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
          class="media hidden≤767"
          style="--focal-point-x: {{ section.settings.image.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image.presentation.focal_point.y }}%"
        >

        <img
          srcset="{% render 'image-srcset', image: section.settings.image_alter %}"
          sizes="100vw"
          src="{{ section.settings.image_alter | image_url: width: 2048 }}"
          alt="{{ section.settings.image_alter.alt | escape }}"
          width="{{ section.settings.image_alter.width }}"
          height="{{ section.settings.image_alter.height }}"
          loading="eager"
          fetchpriority="high"
          class="media hidden≥768"
          style="--focal-point-x: {{ section.settings.image_alter.presentation.focal_point.x }}%; --focal-point-y: {{ section.settings.image_alter.presentation.focal_point.y }}%"
        >

      {%- when 'video' -%}
        <video
          alt="{{ section.settings.video.alt | escape }}"
          width="{{ section.settings.video.preview_image.width }}"
          height="{{ section.settings.video.preview_image.height }}"
          autoplay
          playsinline
          muted
          loop
          preload="auto"
          loading="eager"
          class="media hidden≤767"
        >
          {% for source in section.settings.video.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>

        <video
          alt="{{ section.settings.video_alter.alt | escape }}"
          width="{{ section.settings.video_alter.preview_image.width }}"
          height="{{ section.settings.video_alter.preview_image.height }}"
          autoplay
          playsinline
          muted
          loop
          preload="auto"
          loading="eager"
          class="media hidden≥768"
        >
          {% for source in section.settings.video_alter.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>
    {%- endcase -%}

    <div class="banner-content">
      {%- if section.settings.title != blank -%}
        <h2 class="banner-title typography--heading-1-bold">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}

      <div class="field field--input">
        <label for="EyeExamInput-{{ section.id }}" class="typography--body-small">
          {{- section.settings.form_input_label -}}
        </label>
        <div class="field-line">
          <input
            type="text"
            name="EyeExamInput-{{ section.id }}"
            id="EyeExamInput-{{ section.id }}"
            placeholder="{{ section.settings.form_input_placeholder }}"
            class="typography--body-regular"
          >
          <button id="EyeExamSubmit-{{ section.id }}" class="button button--primary typography--navigation">
            {{ section.settings.form_cta_text }}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

{{ section.settings.script }}

{% style %}
  .hp-eye-exam-{{ section.id }} .banner{
    flex-direction: {{ section.settings.flex_direction }};
  }

  .hp-eye-exam-{{ section.id }} .banner-content{
    background-color: {{ section.settings.background_color }};
  }

  .hp-eye-exam-{{ section.id }} .banner-title,
  .hp-eye-exam-{{ section.id }} label{
    color: {{ section.settings.text_color }}
  }

  @media screen and (min-width: 992px) {

    .hp-eye-exam-{{ section.id }} .banner-content{
      display: grid;
      justify-content: {{ section.settings.text_placement_hor }};
      align-content: {{ section.settings.text_placement_vert }};
      justify-items: {{ section.settings.text_alignment }};
      text-align: {{ section.settings.text_alignment }};
    }

  }

  @media only screen and (max-width: 991px) {
    .hp-eye-exam-{{ section.id }} .banner-content{
      text-align: {{ section.settings.text_alignment_alter }};
    }
  }

  .hp-eye-exam-{{ section.id }} .field--input input {
    background-color: {{ section.settings.form_input_background_color }};
  }

  .hp-eye-exam-{{ section.id }} .field--input input::placeholder {
    color: {{ section.settings.form_input_placeholder_color }};
  }

  @media screen and (min-width: 992px) {
    .hp-eye-exam-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media only screen and (max-width: 991px) {
    .hp-eye-exam-{{ section.id }}{
      padding-top: {{ section.settings.padding_top_alter }}px;
      padding-bottom: {{ section.settings.padding_bottom_alter }}px;
    }
  }
{% endstyle %}
{% schema %}
{
  "name": "HP Eye Exam",
  "tag": "section",
  "class": "section--hp-eye-exam",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "radio",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_alter",
      "label": "Image (Mobile)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "video",
      "id": "video_alter",
      "label": "Video Mobile"
    },
    {
      "type": "radio",
      "id": "flex_direction",
      "label": "Layout Direction",
      "options": [
        {
          "value": "row",
          "label": "Normal"
        },
        {
          "value": "row-reverse",
          "label": "Reverse"
        }
      ],
      "default": "row"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "radio",
      "id": "text_placement_hor",
      "label": "Text Placement Horizontal",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_placement_vert",
      "label": "Text Placement Vertical",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "radio",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "start"
    },
    {
      "type": "radio",
      "id": "text_alignment_alter",
      "label": "Text Alignment (Mobile)",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "start"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "form_input_label",
      "label": "Form Input Label"
    },
    {
      "type": "text",
      "id": "form_input_placeholder",
      "label": "Form Input Placeholder"
    },
    {
      "type": "text",
      "id": "form_cta_text",
      "label": "Form CTA Text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#201F1E"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F8F8F8"
    },
    {
      "type": "color",
      "id": "form_input_placeholder_color",
      "label": "Form Input Placeholder Color",
      "default": "#8A8484"
    },
    {
      "type": "color",
      "id": "form_input_background_color",
      "label": "Form Input Background Color",
      "default": "#ffffff"
    },
    {
      "type": "liquid",
      "id": "script",
      "label": "Script"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "HP Eye Exam"
    }
  ]
}
{% endschema %}
