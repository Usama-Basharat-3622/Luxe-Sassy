{{ 'hp-product-list.css' | asset_url | stylesheet_tag }}

<div
  id="product-list-{{ section.id }}"
  class="product-list-{{ section.id }} product-list isolate"
>
  <div class="product-list-header">
    {%- if section.settings.title != blank -%}
      <h2 class="product-list-title typography--heading-1">
        {{ section.settings.title }}
      </h2>
    {%- endif -%}
    {%- if section.settings.cta_text != blank -%}
      <a
        href="{{ section.settings.cta_link }}"
        class="product-list-cta link button button--tertiary typography--body-regular"
      >
        {{- section.settings.cta_text -}}
      </a>
    {%- endif -%}
  </div>

  {%- case section.settings.source_type -%}
    {%- when 'product_list' -%}
      {%- assign product_list = section.settings.product_list -%}
    {%- when 'collection' -%}
      {%- assign product_list = section.settings.collection.products -%}
  {%- endcase -%}

  <product-carousel class="product-carousel" role="region" {{ section.shopify_attributes }}>
    <div class="swiper isolate">
      <div class="swiper-wrapper">
        {%- for product in product_list -%}
          <div class="swiper-slide">
            {%- capture scope_id -%}
              {{- section.id -}}-{{- section.id -}}
            {%- endcapture -%}
            {% render 'product-card',
              card_product: product,
              card_image_sizes: '(min-width: 1200px) calc(100vw / 4), (min-width: 992px) calc(100vw / 3), (min-width: 768px) calc(100vw / 2), calc(100vw / 1)',
              scope_id: scope_id
            %}
          </div>
        {%- endfor -%}
      </div>
      <div class="swiper-scrollbar"></div>
    </div>
  </product-carousel>

</div>

{% style %}
  @media screen and (min-width: 768px) {
    .product-list-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media only screen and (max-width: 767px) {
    .product-list-{{ section.id }}{
      padding-top: {{ section.settings.padding_top_alter }}px;
      padding-bottom: {{ section.settings.padding_bottom_alter }}px;
    }
  }
{% endstyle %}
{% schema %}
{
  "name": "Product Carousel",
  "tag": "section",
  "class": "section--product-list",
  "enabled_on": {
    "templates": ["page", "index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "header",
      "content": "Product Carousel"
    },
    {
      "type": "radio",
      "id": "source_type",
      "label": "Source Type",
      "options": [
        {
          "value": "product_list",
          "label": "Product List"
        },
        {
          "value": "collection",
          "label": "Collection"
        }
      ],
      "default": "product_list"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Padding Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Carousel"
    }
  ]
}
{% endschema %}
