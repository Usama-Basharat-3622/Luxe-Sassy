<div
  id="blog-article-grid-{{ section.id }}"
  class="blog-article-grid-{{ section.id }} blog-article-grid isolate"
>

  {% assign counter = 0 %}
  <div class="blog-article blog-article-sort">

    {%- for link in linklists['blog-menu'].links -%}
      {%- if link.type == 'blog_link' -%}
        {%- assign blog = link.object -%}
        {%- if blog.articles_count > 0 -%}
          {%- paginate blog.articles by 1000 -%}
            {%- for article in blog.articles -%}
              {%- assign custom_date = article.metafields.custom.custom_publish_date.value -%}
              {%- assign sort_date = custom_date | default: article.published_at -%}
              {% assign counter = counter | plus: 1 %}
              <div
                class="blog-article-grid-item"
                data-sort="-{{ sort_date | date: "%s" }}"
              >
                {% render 'article-card', card_article: article, blog_title: blog.title %}
              </div>
            {%- endfor -%}
          {%- endpaginate -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

  </div>
  {% if counter > 12 %}
    <div class="view-more-button">
      <button id="view-more-button" class="button button--tertiary typography--body-regular">{{ 'blog.blog_page_view_more_articles_label' | t }}</button>
    </div>
  {% endif %}
</div>

{% style %}
  .blog-article-grid-{{ section.id }}:not(:empty){
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .view-more-button {
    display: flex;
    justify-content: center;
  }
  #view-more-button {
    margin: 4rem 0rem 0rem;
  }
  .truncate-lines-2 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2; /* Limit number of lines */
    -webkit-box-orient: vertical;
  }
  .truncate-lines-3 {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3; /* Limit number of lines */
    -webkit-box-orient: vertical;
  }
  @media screen and (min-width: 1025px) {
    .blog-article.blog-article-sort {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      row-gap: 6.2rem;
      column-gap: 1.6rem;
    }
    .section--page-blog-all-article-grid{
      padding: 0rem 2.4rem;
    }
  }
  @media screen and (min-width: 767px) and (max-width: 1024px) {
    .blog-article.blog-article-sort {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      row-gap: 4.4rem;
      column-gap: 1.6rem;
    }
    .section--page-blog-all-article-grid{
      padding: 0rem 1.6rem;
    }
  }
  @media only screen and (max-width: 767px) {
    .blog-article-grid-{{ section.id }}:not(:empty){
      padding-top: {{ section.settings.padding_top_mob }}px;
      padding-bottom: {{ section.settings.padding_bottom_mob }}px;
    }
    .blog-article.blog-article-sort {
      display: grid;
      grid-template-columns: 1fr 1fr;
      row-gap: 4rem;
      column-gap: 1.2rem;
    }
    .section--page-blog-all-article-grid{
      padding: 0rem 1.6rem;
    }
  }
{% endstyle %}

<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.querySelector('.blog-article-sort');
  if (!container) return;

  const elements = Array.from(container.children);
  const sorted = elements.sort((a, b) => +a.dataset.sort - +b.dataset.sort);

  container.innerHTML = '';
  sorted.forEach((elm, i) => {
    if (i > 11) {
      elm.classList.add('hidden');
    } else {
      elm.classList.remove('hidden');
    }
    container.append(elm);
  });

  // View More Button
  const button = document.getElementById('view-more-button');
  if (button) {
    button.addEventListener('click', () => {
      document.querySelectorAll('.blog-article-grid-item.hidden').forEach((el) => {
        el.classList.remove('hidden');
      });
      button.style.display = 'none';
    });
  }
});
</script>

{% schema %}
{
  "name": "Blog Article Grid",
  "tag": "section",
  "class": "section--page-blog-all-article-grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 0
    }
  ]
}
{% endschema %}