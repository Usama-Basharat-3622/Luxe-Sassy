{%- form 'storefront_password', class: 'StorePasswordForm' -%}
  <div class="field field--input">
    <label for="StorePasswordForm-field" class="typography--body-small"> Password </label>
    <div class="field-line">
      <input
        type="password"
        name="password"
        id="StorePasswordForm-field"
        class="typography--body-regular"
        placeholder="Password"
        autocorrect="off"
        autocapitalize="off"
        autocomplete="off"
        required
      >
      <button
        type="submit"
        name="submit"
        id="StorePasswordForm-button"
        class="button button--primary typography--navigation"
      >
        Submit
      </button>
    </div>
  </div>
{%- endform -%}

{% style %}
  .StorePasswordForm {
    margin: 0 auto;
    max-width: 60rem;
    padding: 2.4rem;
  }
{% endstyle %}

{% schema %}
{
  "name": "Password Main",
  "tag": "section",
  "class": "section--password-main",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": []
}
{% endschema %}
