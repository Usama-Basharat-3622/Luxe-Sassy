{{ 'pdp-desc.css' | asset_url | stylesheet_tag }}

<div
  id="pdp-desc-{{ section.id }}"
  class="pdp-desc-{{ section.id }} pdp-desc"
>
  <div id="AnchorTarget-{{ section.settings.section_anchor_id }}" class="anchor-target" aria-hidden="true"></div>
  <h2 class="pdp-specs-title typography--heading-2"> {{ section.settings.title }} </h2>
  <div class="pdp-desc-description typography--body-regular">{{ product.description }}</div>

  {%- if section.settings.product_tag_list_dynamic != blank -%}
    {%- assign metaobject_list = section.settings.product_tag_list_dynamic -%}
  {%- else -%}
    {%- assign metaobject_list = section.settings.product_tag_list_static -%}
  {%- endif -%}

  {% if metaobject_list != blank %}
    <ul class="pdp-desc-tag-list product-tag-list" role="list">
      {%- for metaobject in metaobject_list -%}
        <li class="product-tag-list-item">
          <div class="product-tag">
            {%- if metaobject.image -%}
              <img
                srcset="{% render 'image-srcset', image: metaobject.image %}"
                sizes="24px"
                src="{{ metaobject.image | image_url }}"
                loading="eager"
                alt="{{ metaobject.image.alt | escape }}"
                width="24"
                height="24"
                class="product-tag-image"
              >
            {%- endif -%}
            {%- if metaobject.title -%}
              <h3 class="product-tag-title typography--body-small">{{ metaobject.title }}</h3>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  {% endif %}
</div>

{% style %}
  @media screen and (min-width: 992px) {
    .pdp-desc-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media only screen and (max-width: 991px) {
    .pdp-desc-{{ section.id }}{
      padding-top: {{ section.settings.padding_top_alter }}px;
      padding-bottom: {{ section.settings.padding_bottom_alter }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "PDP Desc",
  "tag": "section",
  "class": "section--pdp-desc",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Product Description"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 0
    }
  ]
}
{% endschema %}
