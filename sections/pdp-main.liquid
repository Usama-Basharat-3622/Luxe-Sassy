{{ 'pdp-main.css' | asset_url | stylesheet_tag }}

<product-info
  id="MainProduct-{{ section.id }}"
  class="pdp-main-{{ section.id }} pdp-main"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>
  <!-- Gallery -->

 <product-gallery
    id="ProductGallery-{{ section.id }}"
    class="pdp-product-gallery pdp-product-gallery-{{ section.id }} isolate"
    role="region"
    aria-label="{{ 'product.media.gallery_label' | t }}"
  >
    <div
      class="dialog-modal-content"
      role="dialog"
      aria-label="Product Zoom Gallery"
      aria-modal="true"
      tabindex="-1"
    >

      <div class="dialog-modal-main isolate">
        <div class="pdp-product-zoom-slider swiper">
          <div class="swiper-wrapper"></div>
           <div class="swiper-pagination"></div>
        </div>

        <div class="pdp-product-zoom-thumbSlider swiper">
          <div class="swiper-wrapper"></div>
        </div>

        <template class="template--slider">
          {% assign product_image_variants = product.variants %}
          {%- for product_image in product.images -%}
              <div
                class="swiper-slide"
                data-media-id="{{ product_image.id }}"
              >
                <modal-opener
                  class="product-zoom-opener modal-opener"
                  data-modal="#ProductZoom-{{ section.id }}"
                >
                  <div class="ratio ratio--inline">
                  <img
                    srcset="{% render 'image-srcset', image: product_image %}"
                    sizes="(min-width: 992px) 50vw, 100vw"
                    src="{{ product_image | image_url: width: 3840 }}"
                    loading="eager"
                    {% if forloop.first %}
                      fetchpriority="high"
                    {% else %}
                      fetchpriority="low"
                    {% endif %}
                    alt="{{ product_image.alt | escape }}"
                    width="{{ product_image.width }}"
                    height="{{ product_image.height }}"
                    class="media"
                    style="--focal-point-x: {{ product_image.presentation.focal_point.x }}%; --focal-point-y: {{ product_image.presentation.focal_point.y }}%"
                  >
                  </div>
                  <button
                    class="covering-button cursor--zoom-in"
                    type="button"
                    aria-haspopup="dialog"
                    data-media-id="{{ product_image.id }}"
                  >
                    <span class="visually-hidden">
                      Open Product Image {{ product_image_index0 | plus: 1 }} in zoom modal
                    </span>
                  </button>
                </modal-opener>
              </div>
          {%- endfor -%}
        </template>

        <template class="template--thumbSlider">
          {%- for product_image in product.images -%}
              <div
                class="swiper-slide"
                data-media-id="{{ product_image.id }}"
              >
                <img
                  srcset="{% render 'image-srcset', image: product_image %}"
                  sizes="120px"
                  src="{{ product_image | image_url: width: 3840 }}"
                  loading="lazy"
                  fetchpriority="low"
                  alt="{{ product_image.alt | escape }}"
                  width="{{ product_image.width }}"
                  height="{{ product_image.height }}"
                  class="media"
                  style="--focal-point-x: {{ product_image.presentation.focal_point.x }}%; --focal-point-y: {{ product_image.presentation.focal_point.y }}%"
                >
              </div>
          {%- endfor -%}
        </template>

        <script type="application/json">
          {{ product.selected_or_first_available_variant | json }}
        </script>
      </div>
    </div>
  </product-gallery>

  <!-- Info -->
  <section
    id="ProductInfo-{{ section.id }}"
    class="pdp-info pdp-info-{{ section.id }}"
  >
    <div id="pdp-info-inner" class="pdp-info-inner">
      {%- assign product_form_id = 'product-form-' | append: section.id -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'breadcrumbs' -%}
            {%- render 'pdp-breadcrumbs', product: product, block: block -%}
          {%- when 'heading' -%}
            <div class="pdp-heading" data-wk-pdp-target {{ block.shopify_attributes }}>
              <div>
                <h2 class="pdp-heading-subtitle typography--heading-2-bold">{{ block.settings.subtitle }}</h2>
              </div>
            </div>
          {%- when 'tag' -%}
            {%- if block.settings.product_tag_list_dynamic != blank -%}
              {%- assign metaobject_list = block.settings.product_tag_list_dynamic -%}
            {%- else -%}
              {%- assign metaobject_list = block.settings.product_tag_list_static -%}
            {%- endif -%}
            {% if metaobject_list != blank %}
              <ul class="pdp-info-tag-list product-tag-list" role="list">
                {%- for metaobject in metaobject_list -%}
                  <li class="product-tag-list-item">
                    <div class="product-tag">
                      <h3 class="product-tag-title typography--body-small">{{ metaobject.title }}</h3>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
            {% endif %}
          {%- when 'price' -%}
            {%- render 'pdp-price', product: product, block: block -%}
          {%- when 'quantity_selector' -%}
            {%- render 'product-quantity-selector', product: product, block: block -%}
          {%- when 'variant_picker' -%}
            {%- render 'product-variant-picker', product: product, block: block -%}
          {%- when 'buy_buttons' -%}
              {%- render 'product-buy-buttons',
                block: block,
                product: product,
                product_form_id: product_form_id,
                section_id: section.id
              -%}
          {%- when 'custom_liquid' -%}
            {{ block.settings.custom_liquid }}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </section>

  <!-- Zoom -->
 

  <!-- Zoom 2 -->
  <product-zoom
    id="ProductZoom-{{ section.id }}"
    class="ProductZoom-{{ section.id }} pdp-product-zoom dialog-modal"
  >
    <div
      class="dialog-modal-content"
      role="dialog"
      aria-label="Product Zoom"
      aria-modal="true"
      tabindex="-1"
    >
      <button
        id="ModalClose-ProductZoom"
        type="button"
        class="dialog-modal-close"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>

      <div class="dialog-modal-main cursor--zoom-out">
        <div class="product-zoom-media-list">
          {%- for product_image in product.images -%}
            <img
              src="{{ product_image | image_url: width: 3840 }}"
              loading="eager"
              fetchpriority="high"
              alt="{{ product_image.alt | escape }}"
              width="{{ product_image.width }}"
              height="{{ product_image.height }}"
              class="media"
              data-media-id="{{ product_image.id }}"
            >
          {%- endfor -%}
        </div>
      </div>
    </div>
  </product-zoom>
</product-info>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

<script>
  document.addEventListener('DOMContentLoaded', (event) => {
    if (window.matchMedia('(max-width: 991px)').matches) {
      ScrollTrigger.create({
        trigger: '#scroll-trigger--pdp',
        endTrigger: '#scroll-trigger--pdp',
        start: 'top bottom',
        end: 'top top',
        toggleClass: { targets: '.product-form__buttons', className: 'static' },
      });
    }
  });
</script>

{% style %}
  .pdp-product-gallery .swiper-slide .ratio--inline {
    --aspect-ratio:{{ section.settings.gallery_aspect_ratio }};
  }
  .pdp-product-gallery .swiper-slide:first-child:last-child .ratio--inline {
    --aspect-ratio: 3 / 2;
  }
{% endstyle %}

{% schema %}
{
  "name": "PDP Main",
  "tag": "section",
  "class": "section--pdp-main",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "radio",
      "id": "gallery_aspect_ratio",
      "label": "Gallery Aspect Ratio",
      "options": [
        {
          "value": "1/1",
          "label": "1 : 1"
        },
        {
          "value": "3/2",
          "label": "3: 2"
        }
      ],
      "default": "1/1"
    }
  ],
  "blocks": [
    {
      "type": "breadcrumbs",
      "name": "Breadcrumbs",
      "limit": 1
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subtitle",
          "label": "Product Title",
          "default": "{{ product.title }}"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "quantity_selector",
      "name": "Quantity Selector",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": []
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
