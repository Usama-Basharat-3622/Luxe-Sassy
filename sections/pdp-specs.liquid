{{ 'pdp-specs.css' | asset_url | stylesheet_tag }}
<script type="application/json" id="VariantWeights-{{ product.id }}">
{
{% for v in product.variants %}
  "{{ v.id }}": {{ v.weight | default: 0 }}{% unless forloop.last %},{% endunless %}
{% endfor %}
}
</script>

{% if section.settings.title != blank and section.blocks.size > 0 %}
  <div
    id="pdp-specs-{{ section.id }}"
    class="pdp-specs-{{ section.id }} pdp-specs"
  >
    <div id="AnchorTarget-{{ section.settings.section_anchor_id }}" class="anchor-target" aria-hidden="true"></div>

    <details-utils force-close="(max-width: 991px)" force-open="(min-width: 992px)">
      <details class="accordion">
        <summary class="accordion-title" aria-controls="AccordionContent-{{ section.id }}" role="button">
          <h2 class="pdp-specs-title typography--heading-2">{{ section.settings.title }}</h2>
          {{- 'icon-plus.svg' | inline_asset_content -}}
        </summary>
        <ul id="AccordionContent-{{ section.id }}" class="pdp-specs-list accordion-content" role="list">
          {%- for block in section.blocks -%}
            {%- assign field_handle = block.settings.handle -%}
            {%- case block.settings.object -%}
              {%- when 'product' -%}
                {%- assign field_value = product[field_handle] -%}
              {%- when 'variant' -%}
                {%- assign field_value = product.selected_or_first_available_variant[field_handle] -%}
              {%- when 'product_metafield' -%}
                {%- assign field_handle_part_1 = field_handle | split: '.' | first -%}
                {%- assign field_handle_part_2 = field_handle | split: '.' | last -%}
                {%- assign field_value = product.metafields[field_handle_part_1][field_handle_part_2].value -%}
              {%- when 'variant_metafield' -%}
                {%- assign field_handle_part_1 = field_handle | split: '.' | first -%}
                {%- assign field_handle_part_2 = field_handle | split: '.' | last -%}
                {%- assign field_value = product.selected_or_first_available_variant.metafields[field_handle_part_1][field_handle_part_2].value -%}
            {%- endcase -%}

            {%- if block.settings.title != blank and field_value != blank -%}
              <li class="pdp-spec-item-{{ block.id }} pdp-spec-item" {{ block.shopify_attributes }}>
                <div class="pdp-spec-title typography--body-regular">{{ block.settings.title }}</div>
                {%- if field_value != blank -%}
                  {% if block.settings.handle == "weight" %}
                    <div class="pdp-spec-value typography--body-regular" data-variant-weight>
                      {{ product.selected_or_first_available_variant.weight }} g
                    </div>
                  {% else %}
                    <div class="pdp-spec-value typography--body-regular">
                      {{ field_value }}
                    </div>
                  {% endif %}
                {%- endif -%}
              </li>
            {% endif %}
          
          {%- endfor -%}
        </ul>
      </details>
    </details-utils>
  </div>
{% endif %}
{% style %}
  @media screen and (min-width: 992px) {
    .pdp-specs-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media only screen and (max-width: 991px) {
    .pdp-specs-{{ section.id }}{
      padding-top: {{ section.settings.padding_top_alter }}px;
      padding-bottom: {{ section.settings.padding_bottom_alter }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "PDP Specs (product)",
  "tag": "section",
  "class": "section--pdp-specs-product",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_anchor_id",
      "label": "Section Anchor ID",
      "default": "specs"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Product Specifications"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_alter",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (Mobile)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "name": "Block",
      "type": "block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "radio",
          "id": "object",
          "label": "Object",
          "options": [
            {
              "value": "variant_metafield",
              "label": "Variant Metafield"
            },
            {
              "value": "product_metafield",
              "label": "Product Metafield"
            },
            {
              "value": "variant",
              "label": "Variant"
            },
            {
              "value": "product",
              "label": "Product"
            }
          ],
          "default": "variant_metafield"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Specs (Product)"
    }
  ]
}
{% endschema %}
