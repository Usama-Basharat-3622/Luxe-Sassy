{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}

<div id="announcement-bar" class="announcement-bar" data-id="{{ section.id }}">
  <!-- Slider -->
  <announcement-bar-slider
    id="announcement-bar-slider-{{ section.id }}"
    class="announcement-bar-slider"
    role="region"
  >
    <div class="swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <div
              class="announcement-bar-slide swiper-slide"
              data-swiper-autoplay="{{ block.settings.promo_bar_slider_interval | times: 1000 }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.link != blank -%}
                <a class="link link--inline-block link--hover-color-change" href="{{ block.settings.link }}">
              {%- endif -%}

              <span class="typography--navigation">
                {{ block.settings.text }}
              </span>

              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button
        class="swiper-button-prev hidden≤767"
        type="button"
        name="previous"
        aria-label="{{ 'accessibility.previous' | t }}"
        aria-controls="announcement-bar-slider-{{ section.id }}"
      >
        {{- 'icon-caret_left.svg' | inline_asset_content -}}
      </button>

      <button
        class="swiper-button-next hidden≤767"
        type="button"
        name="next"
        aria-label="{{ 'accessibility.next' | t }}"
        aria-controls="announcement-bar-slider-{{ section.id }}"
      >
        {{- 'icon-caret_right.svg' | inline_asset_content -}}
      </button>
    </div>
  </announcement-bar-slider>
</div>

{% style %}
  .announcement-bar {
    color: {{ section.settings.promo_bar_text_color }};
    background-color: {{ section.settings.promo_bar_background_color }};
  }
{% endstyle %}

{% schema %}
{
  "name": "Promo Bar",
  "tag": "section",
  "class": "section--announcement-bar",
  "limit": 1,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "promo_bar_text_color",
      "label": "Promo Bar Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "promo_bar_background_color",
      "label": "Promo Bar Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "header",
      "content": "Promo Bar Slider"
    },
    {
      "type": "range",
      "id": "promo_bar_slider_interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Promo Bar Slider Interval",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement-bar-slide",
      "name": "Promo Bar Slide",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Promo Bar Slide Text",
          "label": "Promo Bar Slide Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Promo Bar Slide link"
        }
      ]
    }
  ]
}
{% endschema %}
