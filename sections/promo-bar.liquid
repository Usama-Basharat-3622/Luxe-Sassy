{% style %}
.promo-bar.promo-bar-{{ section.id }} {
  background: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  overflow: hidden;
  padding: 8px 0;
  white-space: nowrap;
}

.promo-bar-{{ section.id }} .promo-bar__track {
  display: inline-flex;
  gap: 150px;
  will-change: transform;
}
.promo-bar-{{ section.id }} .promo-bar__only_item {
  padding: 0 20px;
  display: flex;
  justify-content: center;
}
.promo-bar-{{ section.id }} .promo-bar__item {
  padding: 0 20px;
  display: inline-block;
  white-space: nowrap;
}

{% endstyle %}

<div class="promo-bar promo-bar-{{ section.id }}">
  <div class="typography--navigation {% if section.blocks.size > 1 %}promo-bar__track {% endif %}">
    {% if section.blocks.size <= 1 %}

      {% for block in section.blocks %}
        <span class="promo-bar__only_item">{{ block.settings.text }}</span>
      {% endfor %}

    {% elsif section.blocks.size > 1 %}

      {% for block in section.blocks %}
        <span class="promo-bar__item">{{ block.settings.text }}</span>
      {% endfor %}

    {% endif %}
  </div>
</div>


<script>
document.addEventListener('DOMContentLoaded', () => {
  const track = document.querySelector('.promo-bar__track');
  const bar = document.querySelector('.promo-bar');
  if (!track || !bar) return;

  // Duplicate content until longer than screen width x 2
  while (track.scrollWidth < bar.clientWidth * 2.2) {
    track.innerHTML += track.innerHTML;
  }

  // Measure final width
  const totalWidth = track.scrollWidth;

  // Speed: 80px per second (adjustable)
  const speed = totalWidth / 180;

  // Apply animation using exact width + speed
  track.style.animation = `scrollMarquee ${speed}s linear infinite`;

  const style = document.createElement("style");
  style.innerHTML = `
    @keyframes scrollMarquee {
      from { transform: translateX(0); }
      to { transform: translateX(-${totalWidth / 2}px); }
    }
  `;
  document.head.appendChild(style);
});
</script>


{% schema %}
{
  "name": "Promo Bar",
  "tag": "section",
  "class": "section--promo-bar",
  "limit": 1,
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 10,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Promo Text",
          "default": "Free Shipping on Orders Above $50"
        }
      ]
    }
  ]
}
{% endschema %}
