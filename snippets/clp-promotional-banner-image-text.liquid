{% liquid
  assign banner_image = content_banner.banner_image
  assign banner_image_mobile = content_banner.banner_image_mobile

  assign content_position_desktop = content_banner.content_position_desktop
  assign content_position_mobile = content_banner.content_position_mobile_
  assign position_desktop = content_banner.position_desktop
  assign position_mobile = content_banner.position_mobile
  assign column_position = content_banner.column_position

  assign title = content_banner.title
  assign description = content_banner.description

  assign button_label = content_banner.button_label
  assign button_url = content_banner.button_url

  assign cover_link = content_banner.cover_link

  assign text_color = content_banner.text_color
%}

{% style %}
  .clp-promotional-banner-image-text-{{ index }} {
      position: relative;
  }


  .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content {
      color: {{ text_color }};
  }

  .clp-promo_media-wrap{
      position: relative;
      height: 100%;
  }
  .clp-promo_media-wrap img{
      height: 100%;
  }
  .clp-promo_media-wrap svg{
      height: 100%
  }

  .clp-promo-banner-image__content {
      position: absolute;
      padding: 4rem;
      top: 0;
      bottom: 0;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
  }

  .clp-promo-banner-image__title{
      margin-bottom: 1.6rem;
  }
  .clp-promo-banner-image__title,
  .clp-promo-banner-image__description{
      max-width: 37.5rem;
  }

  .clp-promo-banner-image__button{
      margin-top: 2rem;
      width: max-content;
      z-index: 2;
  }
  .clp-promotional-banner-image-text-{{ index }} video{
      height: 100%;
  }


  @media screen and (min-width: 1025px) {
      .clp-promotional-banner-image-text-{{ index }} {
          {% if column_position == 'left' %}
          grid-column: 1 / span 2;
          {% elsif column_position == 'right' %}
          grid-column: 3 / span 2;
          {% endif %}
          grid-row: {{ position_desktop }} / span 2;
      }

      {% if content_position_desktop == 'Top Left' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-start;
          justify-content: flex-start;
      }
      {% elsif content_position_desktop == 'Top Right' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-end;
          justify-content: flex-start;
          text-align: right;
      }
      {% elsif content_position_desktop == 'Top Center' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: center;
          justify-content: flex-start;
          text-align: center;
      }
      {% elsif content_position_desktop == 'Middle Left' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-start;
          justify-content: center;
      }
      {% elsif content_position_desktop == 'Middle Center' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: center;
          justify-content: center;
          text-align: center;
      }
      {% elsif content_position_desktop == 'Middle Right' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-end;
          justify-content: center;
          text-align: right;
      }
      {% elsif content_position_desktop == 'Bottom Left' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-start;
          justify-content: flex-end;
      }
      {% elsif content_position_desktop == 'Bottom Center' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: center;
          justify-content: flex-end;
          text-align: center;
      }
      {% elsif content_position_desktop == 'Bottom Right' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-end;
          justify-content: flex-end;
          text-align: right;
      }
      {% endif %}








      .clp-promo_media-wrap img, .clp-promo_media-wrap svg{
          position: absolute;
      }
  }

  @media screen and (max-width: 1024px) {
      .clp-promotional-banner-image-text-{{ index }} {
          grid-row: {{ position_mobile }};
      }

      {% if content_position_mobile == 'Top Left' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-start;
          justify-content: flex-start;
      }
      {% elsif content_position_mobile == 'Top Right' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-end;
          justify-content: flex-start;
          text-align: right;
      }
      {% elsif content_position_mobile == 'Top Center' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: center;
          justify-content: flex-start;
          text-align: center;
      }
      {% elsif content_position_mobile == 'Middle Left' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-start;
          justify-content: center;
      }
      {% elsif content_position_mobile == 'Middle Center' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: center;
          justify-content: center;
          text-align: center;
      }
      {% elsif content_position_mobile == 'Middle Right' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-end;
          justify-content: center;
          text-align: right;
      }
      {% elsif content_position_mobile == 'Bottom Left' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-start;
          justify-content: flex-end;
      }
      {% elsif content_position_mobile == 'Bottom Center' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: center;
          justify-content: flex-end;
          text-align: center;
      }
      {% elsif content_position_mobile == 'Bottom Right' %}
      .clp-promotional-banner-image-text-{{ index }} .clp-promo-banner-image__content{
          align-items: flex-end;
          justify-content: flex-end;
          text-align: right;
      }
      {% endif %}






      .clp-promo-banner-image__content {
          padding: 1.6rem;
      }

      .clp-promo-banner-image__title{
          margin-bottom: 0.8rem;
      }
      .clp-promo-banner-image__button{
          margin-top: 1.6rem;
      }
  }
{% endstyle %}

<div class="clp-promotional-banner-image-text-{{ index }}">
  <div class="clp-promo_media-wrap">
    {% assign media_url = banner_image | file_url %}
    {% assign media_url_mobile = banner_image_mobile | file_url %}

    {% if media_url contains '.mp4' %}
      {% if banner_image %}
        <video
          alt="{{ banner_image.alt | escape }}"
          width="{{ banner_image.width }}"
          height="{{ banner_image.height }}"
          autoplay
          playsinline
          muted
          loop
          preload="false"
          loading="lazy"
          class="media hidden≤1024"
        >
          <source src="{{ banner_image | file_url }}">
        </video>
      {% else %}
        {{ 'collection-3' | placeholder_svg_tag: 'hidden≤1024' }}
      {% endif %}

    {% else %}
      {% if banner_image %}
        {{-
          banner_image
          | image_url: width: banner_image.width
          | image_tag:
            loading: 'lazy',
            widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800',
            class: 'media clp-promotional-banner-image-text__media hidden≤1024',
            alt: shop.name
        -}}

      {% else %}
        {{ 'collection-3' | placeholder_svg_tag: 'hidden≤1024' }}
      {% endif %}
    {% endif %}

    {% if media_url_mobile contains '.mp4' %}
      {% if banner_image_mobile %}
        <video
          alt="{{ banner_image_mobile.alt | escape }}"
          width="{{ banner_image_mobile.width }}"
          height="{{ banner_image_mobile.height }}"
          autoplay
          playsinline
          muted
          loop
          preload="false"
          loading="lazy"
          class="media hidden≥1025"
        >
          <source src="{{ banner_image_mobile| file_url }}">
        </video>
      {% else %}
        {{ 'collection-3' | placeholder_svg_tag: 'hidden≥1025' }}
      {% endif %}

    {% else %}
      {% if banner_image_mobile %}
        {{-
          banner_image_mobile
          | image_url: width: banner_image_mobile.width
          | image_tag:
            loading: 'lazy',
            widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800',
            class: 'media clp-promotional-banner-image-text__media hidden≥1025 ',
            alt: shop.name
        -}}
      {% else %}
        {{ 'collection-3' | placeholder_svg_tag: 'hidden≥1025' }}
      {% endif %}
    {% endif %}

    {% if cover_link != blank %}
      <a
        class="link link--covering focus-none"
        href="{{ cover_link }}"
        tabindex="-1"
        aria-hidden="true"
      >
        <span class="visually-hidden">{{ 'accessibility.link_to_item' | t: item: button_label }}</span>
      </a>
    {% endif %}
  </div>

  <div class="clp-promo-banner-image__content">
    {% if title != blank %}
      <h2 class="clp-promo-banner-image__title typography--heading-1">{{ title }}</h2>
    {% endif %}
    {% if description != blank %}
      <p class="clp-promo-banner-image__description typography--body-regular">{{ description }}</p>
    {% endif %}

    {% if button_label != blank %}
      <a
        href="{{ button_url }}"
        class="clp-promo-banner-image__button button button--tertiary typography--body-regular link"
      >
        {{ button_label }}
        {{ 'icon-arrow-full_upright.svg' | inline_asset_content }}
      </a>
    {% endif %}
  </div>
</div>
