<script>
  window.dataLayer = window.dataLayer || [];

  {% if customer %}
    window.dataLayer.push({
      'visitor_type': "logged_in",
      'visitor_id': "{{ customer.id | remove: "'" }}",
      'customer_id': "{{ customer.id | remove: "'" }}",
      'customer_email': "{{ customer.email }}",
      'customer_first_name': "{{ customer.first_name }}",
      'customer_last_name': "{{ customer.last_name }}",
      'customer_orders_count': {{ customer.orders_count }},
      'customer_total_spent': {{ customer.total_spent | divided_by: 100 }},
    });
  {% else %}
    window.dataLayer.push({
      'visitor_type': "guest"
    });
  {% endif %}

  {% if template.name == "index" %}
    window.dataLayer.push({
      event: "home_view",
      page_type: "home",
      ecomm_pagetype: "home"
    });
  {% elsif search.performed %}
    window.dataLayer.push({
      page_type: "searchresults",
      ecomm_pagetype: "category"
    });
  {% elsif template.name == "collection" %}
    window.dataLayer.push({
      page_type: "category",
      collection: "{{ collection.title | remove: "'" }}",
      ecomm_pagetype: "category"
    });
  {% elsif template.name == "product" %}
    window.dataLayer.push({
      page_type: "product",
      collection: "{{ product.collections[0].title | remove: "'" }}",
      product_type: "{{ product.type | remove: "'" }}",
      ecomm_pagetype: "product"
    });
  {% elsif template.name == "cart" %}
    window.dataLayer.push({
      page_type: "cart",
      ecomm_pagetype: "cart"
    });
  {% elsif template.name == "checkout" %}
    window.dataLayer.push({
      page_type: "checkout",
      ecomm_pagetype: "cart"
    });
  {% else %}
    window.dataLayer.push({
      page_type: "other"
    });
  {% endif %}
</script>

<!-- Google Tag Manager -->
<script>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, 'script', 'dataLayer', '{{ settings.gtm_id }}');
</script>
<!-- End Google Tag Manager -->
