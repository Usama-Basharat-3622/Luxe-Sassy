{%- capture scope_id -%}
{{- scope_id -}}-{{- card_product.id -}}
{%- endcapture -%}

{%- assign has_swatch = false -%}
{%- for option in card_product.options_with_values -%}
  {%- assign swatch_count = option.values | map: 'swatch' | compact | size -%}
  {%- if swatch_count > 0 -%}
    {%- assign has_swatch = true -%}
    {%- assign swatch_option_name = option.name -%}
    {%- assign swatch_option_index0 = forloop.index0 -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<product-card class="product-card isolate">
  <div class="product-card-top">
    <div class="product-card-album">
      <div class="ratio ratio--3-2" data-product-card-media>
        <img
          srcset="{% render 'image-srcset', image: card_product.images[0] %}"
          sizes="{{ card_image_sizes }}"
          src="{{ card_product.images[0] | image_url: width: 3840 }}"
          loading="lazy"
          fetchpriority="high"
          alt="{{ card_product.images[0].alt | escape }}"
          width="{{ card_product.images[0].width }}"
          height="{{ card_product.images[0].height }}"
          class="product-card-media media"
        >
        {%- if card_product.images.size > 1 -%}
          <img
            srcset="{% render 'image-srcset', image: card_product.images[1] %}"
            sizes="{{ card_image_sizes }}"
            src="{{ card_product.images[1] | image_url: width: 3840 }}"
            loading="lazy"
            fetchpriority="low"
            alt="{{ card_product.images[1].alt | escape }}"
            width="{{ card_product.images[1].width }}"
            height="{{ card_product.images[1].height }}"
            class="product-card-media media"
          >
        {%- endif -%}
      </div>
      {%- if has_swatch -%}
        <template>
          {%- assign flag_variant = card_product.variants[0] -%}
          {%- assign flag_count = 1 -%}
          {%- for card_product_image in card_product.images -%}
            {%- if card_product_image.attached_to_variant? -%}
              {% assign flag_variant = card_product_image.variants[0] %}
              {%- assign flag_count = 1 -%}
            {%- endif -%}
            {%- if flag_count > 2 -%}
              {%- continue -%}
            {%- else -%}
              {%- assign flag_count = flag_count | plus: 1 -%}
            {%- endif -%}
            <img
              srcset="{% render 'image-srcset', image: card_product_image %}"
              sizes="{{ card_image_sizes }}"
              src="{{ card_product_image | image_url: width: 3840 }}"
              loading="eager"
              fetchpriority="low"
              alt="{{ card_product_image.alt | escape }}"
              width="{{ card_product_image.width }}"
              height="{{ card_product_image.height }}"
              class="product-card-media media"
              data-option-value="{{ flag_variant.options[swatch_option_index0] }}"
            >
          {%- endfor -%}
        </template>
      {%- endif -%}
    </div>

    {% if card_product.metafields.custom.badge_list.value != blank %}
      <ul class="product-badge-list" role="list">
        {% for badge in card_product.metafields.custom.badge_list.value %}
          <li class="product-badge-list-item">
            <div class="product-badge">
              <span class="product-badge-text typography--tag">
                {{- badge.text -}}
              </span>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <a
      class="link link--covering focus-none"
      href="{{ card_product.url | within: collection }}"
      tabindex="-1"
      aria-hidden="true"
      data-product-card-top-link
    >
      <span class="visually-hidden">{{ 'accessibility.link_to_item' | t: item: card_product.title }}</span>
    </a>
  </div>
  <div class="product-card-bottom">
    <div class="product-card-info">
      <div class="product-card-line">
        <a
          class="product-card-vendor typography--navigation link link--block link--hover-color-change"
          href="{{ card_product.url | within: collection }}"
          data-product-card-bottom-link
          data-wk-pc-target
        >
          <h3>{{ card_product.vendor }}</h3>
        </a>
      </div>

      <div class="product-card-line">
        <h4 class="product-card-title typography--navigation">{{ card_product.title }}</h4>

        {%- if has_swatch -%}
          {%- render 'product-card-swatch-picker',
            swatch_option: card_product.options_by_name[swatch_option_name],
            scope_id: scope_id
          -%}
        {%- endif -%}
      </div>

      {%- assign price_disabled = false -%}
      {%- if card_product.type == 'Eyeglasses' -%}
        {%- assign price_disabled = true -%}
        {%- if settings.eyeglasses_price_enabled -%}
          {%- assign price_disabled = false -%}
        {%- endif -%}
      {%- endif -%}
      {%- if card_product.type == 'Sunglasses' -%}
        {%- assign price_disabled = true -%}
        {%- if settings.sunglasses_price_enabled -%}
          {%- assign price_disabled = false -%}
        {%- endif -%}
      {%- endif -%}
      
      {%- unless price_disabled -%}
        <div class="product-card-price" data-product-card-price>
          {% render 'price', variant: card_product.selected_or_first_available_variant, style_class: 'typography--navigation' %}
        </div>
      {%- endunless -%}
    </div>
  </div>
</product-card>
