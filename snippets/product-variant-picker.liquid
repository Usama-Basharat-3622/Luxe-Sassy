{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    class="product-variant-picker"
    data-section="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    <div class="product-option-list">
      {%- for option in product.options_with_values -%}
        {%- assign option_handle = option.name | handle -%}
        {%- assign option_handle = option.name | downcase -%}
        {%- if option_handle == 'color' or option_handle == 'product color' -%}
          <fieldset class="product-option product-option--pill product-form__input product-form__input--pill">
            <div class="product-option-heading">
              <legend class="product-option-title typography--body-regular">
                <span class="typography--heading-2">{{ option.name }}:</span>
                <span class="typography--body-regular" style="line-height: 2;" data-selected-value>
                  {{- option.selected_value -}}
                </span>
              </legend>
            </div>
            {% render 'product-variant-options', product: product, option: option, picker_type: 'swatch' %}
          </fieldset>
        {%- else -%}
          <fieldset class="product-option product-option--pill product-form__input product-form__input--pill">
            <div class="product-option-heading">
              <legend class="product-option-title typography--body-regular">
                <span class="typography--heading-2">{{ option.name }}:</span>
                <span class="typography--body-regular" style="line-height: 2;" data-selected-value>
                  {{- option.selected_value -}}
                </span>
              </legend>
            </div>
            {% render 'product-variant-options', product: product, option: option, picker_type: 'button' %}
          </fieldset>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
