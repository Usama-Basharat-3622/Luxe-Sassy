{{ 'customer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customer.js' | asset_url }}" defer="defer"></script>


<div class="form__wrapper reset_password customer-page">
  {% render 'account-breadcrumbs' %}
  <div class="reset_password_wrapper">
    <div class="reset_password_inner">
      <h1 class="typography--heading-1">
        {{ 'customer.reset_password.title' | t }}
      </h1>

      {%- form 'reset_customer_password', id: 'customer_reset_password' -%}
        <p>
          {{ 'customer.reset_password.subtext' | t }}
        </p>
        <div class="form-grid__container">
          <div class="field field--input typography--body-bold">
                <div class="field-line">
                  <input
                    type="password"
                    name="customer[password]"
                    id="password"
                    data-label="{{ 'customer.reset_password.password' | t | replace: 'ENTER', '' | replace: '*', '' }}"
                    placeholder="{{ 'customer.reset_password.password' | t }}"
                    {% if form.errors contains 'password' %}
                      aria-invalid="true"
                      aria-describedby="password-error"
                    {% endif %}
                    required
                  >
                  <label for="password" class="typography--button">{{ 'customer.reset_password.password' | t }}</label>
                </div>
                <p class="field-caption typography--caption">
                  <span class="form-message--error  active"></span>
                </p>
              </div>
        </div>
        <div class="form-grid__container">
          <div class="field field--input typography--body-bold">
                <div class="field-line">
                  <input
                    type="password"
                    name="customer[password_confirmation]"
                    id="password_confirmation"
                    autocomplete="new-password"
                    data-label="{{ 'customer.reset_password.password_confirm' | t | replace: 'ENTER', '' | replace: '*', '' }}"
                    placeholder="{{ 'customer.reset_password.password_confirm' | t }}"
                    {% if form.errors contains 'password_confirmation' %}
                      aria-invalid="true"
                      aria-describedby="password_confirmation-error"
                    {% endif %}
                    required
                  >
                  <label for="password_confirmation" class="typography--button">{{ 'customer.reset_password.password_confirm' | t }}</label>
                </div>
                <p class="field-caption typography--caption">
                  <span class="form-message--error  active">
                    {%- if form.errors -%}
                      {%- for field in form.errors -%}
                        {%- if field == 'form' -%}
                          {{ form.errors.messages[field] }}
                        {%- else -%}
                          {{ form.errors.translated_fields[field] | capitalize }}
                          {{ form.errors.messages[field] }}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                  </span>
                </p>
              </div>
        </div>
        <div class="recover-btns-wrapper">
            <div class="form-grid">
              <button
                class="button button--solid-black typography--button"
                onclick="return validateForm(event);"
              >
                {{ 'customer.reset_password.submit' | t }}
              </button>
            </div>
            <div class="form-grid">
              <a
                href="{{ routes.account_login_url }}"
                class="button button--outline-black typography--button"
              >
                {{ 'customer.login_page.cancel' | t }}
              </a>
            </div>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

<script>
  // Form Validation
  const inputRequiredFields = [...document.querySelectorAll('.form__wrapper .field--input input[required]')];
  inputRequiredFields.forEach((field) => {
    field.addEventListener('keyup', function () {
      if (field.value.trim() === '') {
        setErrorFor(field);
      } else if (field.value.length < 5) {
        const errorMessage = "{{ 'customer.reset_password.password_length' | t }}";
        setErrorFor(field, errorMessage);
      } else {
        setSuccessFor(field);
      }

      if (field.id === 'password_confirmation' && field.value != '') {
        if (misMatch(field.value)) {
          const errorMessage = "{{ 'customer.reset_password.password_mismatch' | t }}";
          setErrorFor(field, errorMessage);
        } else {
          setSuccessFor(field);
        }
      }
    });
  });

  const ResetForm = document.getElementById('customer_reset_password');
  let isValid = true;

  function validateForm(e) {
    isValid = true;
    e.preventDefault();
    checkInputs();
    //console.log(isValid)
    if (isValid) {
      ResetForm.submit();
      return true;
    } else {
      focusForm();
      return false;
    }
  }

  function checkInputs() {
    const requiredFields = document.querySelectorAll('.form__wrapper .field--input input[required]');
    const inputFields = [...requiredFields];
    inputFields.forEach((field) => {
      if (field.value.trim() === '') {
        setErrorFor(field);
      } else if (field.value.length < 5) {
        const errorMessage = "{{ 'customer.reset_password.password_length' | t }}";
        setErrorFor(field, errorMessage);
      } else {
        setSuccessFor(field);
      }

      if (field.id === 'password_confirmation' && field.value != '') {
        if (misMatch(field.value)) {
          const errorMessage = "{{ 'customer.reset_password.password_mismatch' | t }}";
          setErrorFor(field, errorMessage);
        } else {
          setSuccessFor(field);
        }
      }
    });
  }

  function setErrorFor(input, errorMessage = '') {
    const formControl = input.parentElement.parentElement;
    const small = formControl.querySelector('span');
    formControl.classList.add('field--error');

    const label = formControl.querySelector('label');
    const messagePrefix = label.textContent.replace('*', '');
    const message = `${messagePrefix} {{ 'customer.login_page.error' | t }}`;
    small.innerText = errorMessage != '' ? errorMessage : message;
    isValid = false;
  }

  function setSuccessFor(input) {
    const formControl = input.parentElement.parentElement;
    const small = formControl.querySelector('span');
    small.innerText = '';
    formControl.classList.remove('field--error');
  }

  function focusForm() {
    const inputRequiredFields = [...document.querySelectorAll('.form__wrapper .field--input input[required]')];
    let inValidElem = [];
    inputRequiredFields.forEach((field) => {
      if (field.value.trim() === '') {
        inValidElem.push(field);
      }
    });
    inValidElem[0].focus();
  }

  function misMatch(value) {
    //console.log(value)
    const passwordValue = document.getElementById('password').value;
    return value != passwordValue;
  }
</script>
